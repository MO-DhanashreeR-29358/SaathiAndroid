    <!--Lead Profile Questions-->
    <string name="basic_profile_question1">Q.1) How long you have been investing in the stock market?</string>
    <string name="basic_profile_q1_option1">Very experienced - have been primarily TRADING in equity &amp; derivative market for more than 5 Years</string>
    <string name="basic_profile_q1_option2">Very experienced - have been primarily INVESTING in equity &amp; derivative market for more than 5 years </string>
    <string name="basic_profile_q1_option3">Experienced - have been TRADING in equity &amp; derivative market for 1-5 years</string>
    <string name="basic_profile_q1_option4">Experienced - have been INVESTING in equity &amp; derivative market for 1-5 years</string>
    <string name="basic_profile_q1_option5">Novice - just started my stock market investment which is less than a year</string>

    <string name="basic_profile_question2">Q.2) What best describes your trading style?</string>
    <string name="basic_profile_q2_option1">Will follow our investment advice mostly (Delegator)</string>
    <string name="basic_profile_q2_option2">Will follow own investment ideas , need us for execution only (Self-directed) </string>
    <string name="basic_profile_q2_option3">Will primarily call us for validating the ideas (Validator)</string>

    <string name="basic_profile_question3">Q.3) What do you intend to follow when you are investing?</string>
    <string name="basic_profile_q3_option1">Technical Analysis</string>
    <string name="basic_profile_q3_option2">Fundamental Analysis</string>
    <string name="basic_profile_q3_option3">Both</string>
    <string name="basic_profile_q3_option4">Trades on Tips</string>

    <string name="basic_profile_question4">Q.4) Current stage of Life</string>
    <string name="basic_profile_q4_option1">Single with few financial commitments</string>
    <string name="basic_profile_q4_option2">Married</string>
    <string name="basic_profile_q4_option3">Married with children</string>
    <string name="basic_profile_q4_option4">Preparing for retirement</string>
    <string name="basic_profile_q4_option5">Retired</string>

    <string name="basic_profile_question5">Q.5) Which channel would you prefer?</string>
    <string name="basic_profile_q5_option1">Online</string>
    <string name="basic_profile_q5_option2">Offline</string>
    <string name="basic_profile_q5_option3">Both</string>

    <string name="income_portfolio_question1">Q.1) How much are you intending to invest over the next 1 year with us?</string>
    <string name="income_portfolio_q1_option1">Upto 5 lakhs</string>
