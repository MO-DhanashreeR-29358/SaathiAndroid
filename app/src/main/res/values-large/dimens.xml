    <dimen name="appTableWithWidth">@dimen/_125sdp</dimen>
    <dimen name="header1">@dimen/_17sdp</dimen>
    <dimen name="drawerWidth">@dimen/_200sdp</dimen>
    <dimen name="notification_icon">@dimen/_2sdp</dimen>
    <dimen name="txt_size_profile">@dimen/_9sdp</dimen>
</resources>