<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dashbord_background"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/list_bacground"
        android:orientation="vertical"
        android:paddingBottom="@dimen/_20sdp">


        <LinearLayout
            android:id="@+id/linearLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/tvName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentLeft="true"
                    android:layout_marginLeft="@dimen/_7sdp"
                    android:layout_marginTop="@dimen/_7sdp"
                    android:text="Divesh"
                    android:textColor="@color/black"
                    android:textSize="@dimen/_14sdp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvProfile"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_5sdp"
                    android:layout_toLeftOf="@+id/tvProfileName"
                    android:text="Advisory"
                    android:textColor="@color/tv_color"
                    android:textSize="@dimen/_10sdp" />

                <TextView
                    android:id="@+id/tvProfileName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentRight="true"
                    android:layout_marginRight="@dimen/_7sdp"
                    android:layout_marginTop="@dimen/_5sdp"
                    android:text="123456789"
                    android:textColor="@color/tv_color"
                    android:textSize="@dimen/_10sdp" />
            </RelativeLayout>

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/_3sdp">

                <TextView
                    android:id="@+id/tvIdName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentLeft="true"
                    android:layout_marginLeft="@dimen/_7sdp"
                    android:layout_marginTop="@dimen/_2sdp"
                    android:text="UCID:"
                    android:textColor="@color/tv_color"
                    android:textSize="@dimen/_10sdp" />

                <TextView
                    android:id="@+id/tvID"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/_2sdp"
                    android:layout_marginTop="@dimen/_2sdp"
                    android:layout_toRightOf="@+id/tvIdName"
                    android:text="T0001"
                    android:textColor="@color/tv_color"
                    android:textSize="@dimen/_10sdp" />

                <TextView
                    android:id="@+id/tvCurrentStageName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_toLeftOf="@+id/tvCurrentStage"
                    android:text="Current Stage:"
                    android:textColor="@color/tv_color"
                    android:textSize="@dimen/_10sdp" />

                <TextView
                    android:id="@+id/tvCurrentStage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentRight="true"
                    android:layout_marginRight="@dimen/_7sdp"
                    android:text=" C3"
                    android:textColor="@color/tv_color"
                    android:textSize="@dimen/_10sdp" />
            </RelativeLayout>


            <View
                android:id="@+id/bottomView"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_1sdp"
                android:background="@color/light_grey_menu"
                android:visibility="gone"></View>

            <LinearLayout
                android:id="@+id/llChild"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

            </LinearLayout>

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageView
                    android:id="@+id/ivRightArrow"
                    android:layout_width="@dimen/_30sdp"
                    android:layout_height="@dimen/_20sdp"
                    android:layout_alignParentRight="true"
                    android:layout_marginBottom="@dimen/_minus5sdp"
                    android:src="@drawable/ic_dot_right_arrow" />
            </RelativeLayout>
        </LinearLayout>
    </LinearLayout>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_minus20sdp">

        <ImageView
            android:id="@+id/arrowImageView"
            android:layout_width="@dimen/_30sdp"
            android:layout_height="@dimen/_47sdp"
            android:layout_centerInParent="true"
            android:src="@drawable/expandable_cell_open" />
    </RelativeLayout>


</LinearLayout>