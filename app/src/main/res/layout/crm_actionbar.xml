<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/actionBarNew"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/secondaryBackground"
    >

    <RelativeLayout
        android:id="@+id/rl_actionbar"
        android:layout_width="match_parent"
        android:layout_height="?actionBarSize"
        >

        <android.support.v7.widget.AppCompatImageView
            android:id="@+id/btnMenu"
            android:layout_width="@dimen/_32sdp"
            android:layout_height="@dimen/_18sdp"
            android:layout_alignParentBottom="true"
            android:layout_alignParentLeft="true"
            android:layout_alignParentStart="true"
            android:layout_alignParentTop="true"
            android:layout_centerVertical="true"
            android:background="@null"
            android:padding="@dimen/_6sdp"
            app:srcCompat="@drawable/ic_updated_menu"
            />

        <LinearLayout
            android:layout_width="0px"
            android:layout_height="0px"
            android:focusable="true"
            android:focusableInTouchMode="true"
            />

        <LinearLayout
            android:id="@+id/llSearch"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginBottom="@dimen/_4sdp"
            android:layout_marginLeft="5dp"
            android:layout_marginRight="5dp"
            android:layout_marginTop="@dimen/_4sdp"
            android:layout_toLeftOf="@+id/btnNotification"
            android:layout_toRightOf="@+id/btnMenu"
            android:background="@drawable/textborder"
            android:orientation="horizontal"
            >
            <!--
                        <android.support.v7.widget.AppCompatImageView

                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:layout_margin="@dimen/_3sdp"
                            android:layout_marginLeft="5dp"
                            android:background="@android:color/transparent"
                            app:srcCompat="@drawable/ic_new_search" />-->
            <!-- app:srcCompat="@drawable/ic_new_search"-->
            <!--  <FrameLayout
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content">-->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                >

                <com.mosl.tabapp.clientsearch.DelayAutoCompleteTextView
                    android:id="@+id/searchText"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:autoText="false"
                    android:background="@android:color/transparent"
                    android:drawableLeft="@drawable/ic_msearch"
                    android:dropDownHeight="match_parent"
                    android:dropDownWidth="wrap_content"
                    android:gravity="center_vertical"
                    android:hint="@string/SS_SEARCH_HINT_TXT"
                    android:inputType="textAutoComplete|textAutoCorrect"
                    android:maxLength="90"
                    android:paddingLeft="5dp"
                    android:textSize="@dimen/_12sdp"
                    />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="right|center"
                    android:orientation="horizontal"
                    >

                    <ProgressBar
                        android:id="@+id/pbLoadingIndicator"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginRight="5dp"
                        style="?android:attr/progressBarStyleSmall"
                        />

                    <android.support.v7.widget.AppCompatImageView
                        android:id="@+id/srchImg"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_margin="@dimen/_3sdp"
                        android:background="@android:color/transparent"
                        app:srcCompat="@drawable/ic_arrow_down_black"
                        />

                    <!--   <TextView
                           android:id="@+id/tvMsgCount"
                           android:layout_width="wrap_content"
                           android:layout_height="wrap_content"
                           android:layout_alignParentRight="true"
                           android:layout_centerVertical="true"
                           android:layout_marginLeft="@dimen/_2sdp"
                           android:layout_marginRight="@dimen/_10sdp"
                           android:text="0"/>
                           -->
                </LinearLayout>

                <!-- app:srcCompat="@drawable/ic_new_search"-->
            </FrameLayout>

        </LinearLayout>

        <android.support.v7.widget.AppCompatImageView
            android:id="@+id/btnNotification"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:layout_marginLeft="@dimen/_2sdp"
            android:layout_marginRight="@dimen/_10sdp"
            android:background="@android:color/transparent"
            app:srcCompat="@drawable/ic_new_notification_icon"
            />

        <FrameLayout
            android:id="@+id/flLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:layout_marginRight="@dimen/_4sdp"
            >

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                >


                <view
                    android:id="@+id/ivIcon"
                    class="android.support.v7.widget.AppCompatImageView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/notification_icon"
                    android:visibility="gone"
                    app:srcCompat="@drawable/ic_bubble"
                    />

                <TextView
                    android:id="@+id/tvMsgCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:layout_marginRight="@dimen/_6sdp"
                    android:layout_marginTop="@dimen/_5sdp"

                    android:textSize="@dimen/_10sdp"
                    android:visibility="visible"
                    />
            </RelativeLayout>

        </FrameLayout>

    </RelativeLayout>

    <TextView
        android:id="@+id/appTitle"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/rl_actionbar"
        android:background="@color/titleBarBackground"
        android:ellipsize="end"
        android:gravity="center_horizontal"
        android:paddingBottom="4dp"
        android:paddingLeft="24dp"
        android:paddingRight="24dp"
        android:paddingTop="4dp"
        android:singleLine="true"
        android:text="Title"
        android:textColor="@color/alternateTextColor"
        android:textSize="@dimen/appTitleTextSize"
        android:textStyle="bold"
        android:visibility="gone"
        />


</RelativeLayout>