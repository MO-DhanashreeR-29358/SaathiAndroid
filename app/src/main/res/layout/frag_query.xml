        <TextView
            android:id="@+id/txtBranchCode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_10sdp"
            android:text="Branch Code" />


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="right"
            android:orientation="horizontal">

            <android.view.View
                android:id="@+id/branchCode"
                android:layout_width="5dp"
                android:layout_height="match_parent"
                android:background="@color/orange" />

            <EditText
                android:id="@+id/edttxtBranchCode"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_30sdp"
                android:layout_gravity="center_horizontal"
                android:background="@color/white"
                android:hint="Branch Code" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_15sdp">

            <Button
                android:id="@+id/btnSubmit"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/button_highlight"
                android:text="Submit" />

            <Button
                android:id="@+id/btnReset"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/_10sdp"
                android:layout_weight="1"
                android:background="@drawable/button_highlight"
                android:text="Reset" />

        </LinearLayout>


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_10sdp">

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginRight="5dp"
                android:src="@drawable/ic_call_query" />

            <TextView
                android:id="@+id/txtContactUs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Contact Us"
                android:textColor="#FFA96602"
                android:textSize="18sp"
                android:textStyle="bold" />

        </LinearLayout>

        <TextView
            android:id="@+id/txtSupportQuery"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Support Related Queries" />


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/txtTelephoneNo1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="91-22-39982515"
                android:textColor="#FFA96602"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="5dp"
                android:text="/"
                android:textColor="#FFA96602"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtTelephoneNo2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="91-22-67490600"
                android:textColor="#FFA96602"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>