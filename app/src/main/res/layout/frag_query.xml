<?xml version="1.0" encoding="UTF-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">


    <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:id="@+id/Query"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FFDCD7D7"
        android:orientation="vertical"
        android:padding="15dp">

        <TextView
            android:id="@+id/txtQueryDescription"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Query Description" />


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="right"
            android:orientation="horizontal">

            <android.view.View
                android:id="@+id/queryDescription"
                android:layout_width="5dp"
                android:layout_height="match_parent"
                android:background="@color/orange" />

            <EditText
                android:id="@+id/edQueryText"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_60sdp"
                android:background="@color/white"
                android:gravity="top"
                android:hint="Query Description"
                android:digits="ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789,@!#&amp;()_"
                android:maxLength="500" />

            <requestFocus />

        </LinearLayout>

        <TextView
            android:id="@+id/txtYourName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_10sdp"
            android:text="Your Name" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="right"
            android:orientation="horizontal">

            <android.view.View
                android:id="@+id/PartnerName"
                android:layout_width="5dp"
                android:layout_height="match_parent"
                android:background="@color/orange" />
            <!--changed from Partner name to your name 5/04/2017 Sanket gurav-->
            <EditText
                android:id="@+id/edttxtYourName"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_30sdp"
                android:layout_gravity="center_horizontal"
                android:background="@color/white"
                android:hint="Your Name" />

        </LinearLayout>

        <!--<TextView
            android:id="@+id/txtPartnerCode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Partner Code"
            android:textSize="18sp" />


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="right"
            android:orientation="horizontal">

            <android.view.View
                android:id="@+id/partnerCode"
                android:layout_width="5dp"
                android:layout_height="match_parent"
                android:background="@color/orange" />

