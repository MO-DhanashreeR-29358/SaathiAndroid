<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dashboard_background">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <include
            android:id="@+id/layoutTopSection"
            layout="@layout/lms_top_section_update" />
        <RelativeLayout
            android:id="@+id/rlDate"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_40sdp"
            android:layout_marginTop="@dimen/_5sdp"
            android:background="@drawable/list_bacground">

            <TextView
                android:id="@+id/tvMeetingDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:layout_marginStart="@dimen/_3sdp"
                android:text="@string/txt_lable_meeting_date"
                android:textColor="@color/black"
                android:textSize="@dimen/_12sdp" />

            <TextView
                android:id="@+id/tvDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginStart="@dimen/_5sdp"
                android:layout_toEndOf="@+id/tvMeetingDate"
                android:textColor="@color/black"
                android:textSize="@dimen/_12sdp" />

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/ivDatePicker"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:layout_marginEnd="@dimen/_10sdp"
                app:srcCompat="@drawable/ic_calendar" />

        </RelativeLayout>
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_activity_type"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_5sdp"
            app:errorTextAppearance="@style/error_appearance"
            app:hintEnabled="false">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_activity_type"
                style="@style/EditTextHint"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_22sdp"
                android:hint="@string/txt_lable_activity_type" />

            <Spinner
                android:id="@+id/spActivityType"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_40sdp"/>
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_meeting_reason"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_5sdp"
            app:hintEnabled="false">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_meeting_reason"
                style="@style/EditTextHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/txt_lable_meeting_reason" />
            <Spinner
                android:id="@+id/spMeetingReason"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_40sdp"
                android:entries="@array/Select_Meeting_Reason" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout
             android:id="@+id/til_intrested_in"
             android:layout_width="match_parent"
             android:layout_height="wrap_content"
             android:layout_marginTop="@dimen/_5sdp"
             app:hintEnabled="false">

             <com.google.android.material.textfield.TextInputEditText
                 android:id="@+id/et_intrested_in"
                 style="@style/EditTextHint"
                 android:layout_width="match_parent"
                 android:layout_height="wrap_content"
                 android:hint="@string/label_intrested_in" />
             <Spinner
                 android:id="@+id/spIntrestedIn"
                 android:layout_width="match_parent"
                 android:layout_height="@dimen/_40sdp"
                 android:entries="@array/Select_Meeting_Reason" />
         </com.google.android.material.textfield.TextInputLayout>

         <com.google.android.material.textfield.TextInputLayout
             android:id="@+id/til_meeting_duration"
             android:layout_width="match_parent"
             android:layout_height="wrap_content"
             android:layout_marginTop="@dimen/_5sdp"
             app:errorTextAppearance="@style/error_appearance"
             app:hintEnabled="false">

             <com.google.android.material.textfield.TextInputEditText
                 android:id="@+id/et_meeting_duration"
                 style="@style/EditTextHint"
                 android:layout_width="match_parent"
                 android:layout_height="@dimen/_22sdp"
                 android:hint="@string/txt_lable_meeting_duration" />

             <Spinner
                 android:id="@+id/spMeetingDuration"
                 android:layout_width="match_parent"
                 android:layout_height="@dimen/_40sdp" />

         </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_3sdp"
            app:errorTextAppearance="@style/error_appearance">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etMeetingDescription"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_80sdp"
                android:digits="ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789 ,@!#&amp;()_."
                android:hint="@string/hint_lable_enter_meeting_description"
                android:inputType="textMultiLine"
                android:maxLength="500"
                android:textCursorDrawable="@null" />
        </com.google.android.material.textfield.TextInputLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/llAttendee"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_40sdp"
            android:layout_marginStart="@dimen/_5sdp"
            android:layout_marginTop="@dimen/_10sdp"
            android:layout_marginEnd="@dimen/_5sdp"
            android:background="@drawable/textview_border"
            app:layout_constraintTop_toBottomOf="@+id/tvAPPDateError">

            <TextView
                android:id="@+id/tvAttendee"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/_3sdp"
                android:paddingTop="@dimen/_10sdp"
                android:paddingBottom="@dimen/_10sdp"
                android:text="@string/text_label_attendee"
                android:textColor="@color/black"
                android:textSize="@dimen/_12sdp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:ignore="RtlSymmetry" />

            <TextView
                android:id="@+id/tvAttendeeCount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margin_small"
                android:layout_marginEnd="@dimen/margin_small"
                android:paddingStart="@dimen/_5sdp"
                android:paddingTop="@dimen/_10sdp"
                android:paddingBottom="@dimen/_10sdp"
                android:textColor="@color/black"
                android:textSize="@dimen/_12sdp"
                app:layout_constraintEnd_toStartOf="@+id/ibAttendee"
                app:layout_constraintStart_toEndOf="@+id/tvAttendee"
                app:layout_constraintTop_toTopOf="parent"
                tools:ignore="RtlSymmetry" />

            <ImageButton
                android:id="@+id/ibAttendee"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:layout_marginEnd="@dimen/_5sdp"
                android:background="@color/white"
                android:src="@drawable/ic_plus"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:ignore="ContentDescription" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_meeting_objective"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_5sdp"
            app:errorTextAppearance="@style/error_appearance"
            app:hintEnabled="false">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_meeting_objective"
                style="@style/EditTextHint"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_22sdp"
                android:hint="@string/txt_lable_meeting_objective" />

            <Spinner
                android:id="@+id/spMeetingObjective"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_40sdp" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_3sdp"
            app:errorTextAppearance="@style/error_appearance">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etCustRemark"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_40sdp"
                android:digits="ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789 ,@!#&amp;()_."
                android:hint="@string/label_cust_remark"
                android:inputType="textMultiLine"
                android:maxLength="500"
                android:textCursorDrawable="@null" />
        </com.google.android.material.textfield.TextInputLayout>

    <LinearLayout
        android:id="@+id/llLocationGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_loc_add"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_5sdp"
            app:errorTextAppearance="@style/error_appearance"
            app:hintEnabled="false">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_loc_add"
                style="@style/EditTextHint"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_22sdp"
                android:hint="@string/label_loc_add" />

            <Spinner
                android:id="@+id/spLocationAdd"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_40sdp"/>
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_3sdp"
            app:errorTextAppearance="@style/error_appearance">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etMeetingAdd"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_60sdp"
                android:digits="ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789 ,@!#&amp;()_"
                android:inputType="textMultiLine"
                android:maxLines="6"
                android:clickable="true"
                android:focusable="false"
                android:padding="3dp"
                android:background="@color/white"
                android:scrollHorizontally="false"
                android:scrollbars="vertical"
                android:gravity="top|left"
                android:textSize="18dp"
                android:textCursorDrawable="@null" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/tvTravellingMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:text="@string/txt_lable_travelling_mode"
            android:textColor="@color/text_color_personal"
            android:textSize="@dimen/_11sdp" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_travelling_mode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_5sdp"
            app:errorTextAppearance="@style/error_appearance"
            app:hintEnabled="false">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_travelling_mode"
                style="@style/EditTextHint"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_22sdp"
                android:hint="@string/txt_lable_travelling_mode" />

            <Spinner
                android:id="@+id/spTravellingMode"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_40sdp"
                android:entries="@array/Select" />

        </com.google.android.material.textfield.TextInputLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvTravellingList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_3sdp"
            app:errorTextAppearance="@style/error_appearance">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etAddPinCode"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_40sdp"
                android:digits="0123456789"
                android:hint="@string/label_pin_code"
                android:inputType="number"
                android:maxLength="6"
                android:textCursorDrawable="@null" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_3sdp"
            app:errorTextAppearance="@style/error_appearance">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etMeetingAmount"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_40sdp"
                android:digits="0123456789"
                android:hint="@string/label_amount"
                android:inputType="number"
                android:maxLength="4"
                android:textCursorDrawable="@null" />
        </com.google.android.material.textfield.TextInputLayout>

    </LinearLayout>
        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="@dimen/_60sdp"
            android:orientation="horizontal"
            android:layout_marginStart="@dimen/_10sdp"
            android:layout_marginTop="@dimen/_15sdp"
            android:layout_marginEnd="@dimen/_10sdp">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnSave"
                android:layout_width="0dp"
                android:layout_height="@dimen/_40sdp"
                android:layout_marginEnd="@dimen/_5sdp"
                android:layout_weight="1"
                android:background="@drawable/btn_yellow_background"
                android:fontFamily="@font/lato_reg"
                android:text="@string/text_button_save"
                android:textColor="@color/white"
                android:textFontWeight="500"
                android:textSize="@dimen/_14ssp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnReset"
                android:layout_width="0dp"
                android:layout_height="@dimen/_40sdp"
                android:layout_marginStart="@dimen/_5sdp"
                android:layout_weight="1"
                android:background="@drawable/btn_gray_background"
                android:fontFamily="@font/lato_reg"
                android:text="@string/lbl_reset"
                android:textColor="@color/clr_btn_reset"
                android:textFontWeight="500" />

        </androidx.appcompat.widget.LinearLayoutCompat>

    </LinearLayout>


</ScrollView>