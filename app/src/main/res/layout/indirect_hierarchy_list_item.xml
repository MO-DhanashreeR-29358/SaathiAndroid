<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">


    <LinearLayout
        android:id="@+id/mainContainer"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_gravity="center"
        android:background="@color/white">
        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:background="@color/gray_light"></View>

        <RelativeLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical">
        <!-- Toggle button for expand/collapse -->
        <View
            android:layout_width="0.5dp"
            android:layout_height="match_parent"
            android:background="@color/gray_light"
            android:layout_toStartOf="@+id/revenue"></View>

        <ImageView
            android:id="@+id/toggleButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_expand"
            android:layout_marginEnd="5dp"
            android:layout_centerVertical="true"
            android:contentDescription="Expand/Collapse" />

        <TextView
            android:id="@+id/salesRMName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Sales RM Name  kkhdf "
            android:textSize="16sp"
            android:textColor="@color/black"
            android:layout_centerVertical="true"
            android:gravity="start"
            android:layout_marginEnd="5dp"
            android:layout_toStartOf="@+id/revenueDivider"
            android:layout_toEndOf="@+id/toggleButton"/>
        <View
            android:id="@+id/revenueDivider"
            android:layout_width="0.5dp"
            android:layout_height="match_parent"
            android:background="@color/gray_light"
            android:layout_toStartOf="@+id/revenue"></View>
        <TextView
            android:id="@+id/revenue"
            android:layout_width="100dp"
            android:layout_height="wrap_content"
            android:textColor="@color/black"
            android:text="Revenue"
            android:gravity="right"
            android:layout_centerVertical="true"
            android:layout_marginEnd="5dp"
            android:layout_toStartOf="@+id/lastDivider"/>
        <View
            android:id="@+id/lastDivider"
            android:layout_width="0.5dp"
            android:layout_height="match_parent"
            android:background="@color/gray_light"
            android:layout_alignParentEnd="true"
            ></View>

        </RelativeLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:background="@color/gray_light"></View>

    </LinearLayout>



    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/subordinatesRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
</LinearLayout>
