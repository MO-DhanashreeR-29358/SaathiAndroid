<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dashboard_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <include
            android:id="@+id/layoutTopSection"
            layout="@layout/lms_top_section_update" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_activity_type"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_5sdp"
            app:errorTextAppearance="@style/error_appearance"
            app:hintEnabled="false">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_activity_type"
                style="@style/EditTextHint"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_22sdp"
                android:hint="@string/txt_lable_activity_type" />

            <Spinner
                android:id="@+id/spActivityType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_chips"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_5sdp"
            app:errorTextAppearance="@style/error_appearance"
            app:hintEnabled="false"
            android:visibility="gone">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_chips"
                style="@style/EditTextHint"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_22sdp"
                android:hint="@string/txt_lable_chips" />

            <Spinner
                android:id="@+id/spChips"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </com.google.android.material.textfield.TextInputLayout>


        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_mobile_number"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_5sdp"
            android:visibility="gone"
            app:errorTextAppearance="@style/error_appearance"
            app:hintEnabled="false">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_mobile_number"
                style="@style/EditTextHint"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_22sdp"
                android:hint="@string/txt_lable_mobile_number" />

            <Spinner
                android:id="@+id/spMobileNumber"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </com.google.android.material.textfield.TextInputLayout>


        <Button
            android:id="@+id/btnSendOtp"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_30sdp"
            android:layout_margin="@dimen/margin_small"
            android:text="@string/btn_label_send_otp"
            android:textColor="@color/white"
            android:visibility="gone" />

        <RelativeLayout
            android:id="@+id/rlDate"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_30sdp"
            android:layout_marginTop="@dimen/_5sdp"
            android:background="@drawable/list_bacground">

            <TextView
                android:id="@+id/tvMeetingDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:layout_marginStart="@dimen/_3sdp"
                android:text="@string/txt_lable_meeting_date"
                android:textColor="@color/black"
                android:textSize="@dimen/_12sdp" />

            <TextView
                android:id="@+id/tvDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginStart="@dimen/_5sdp"
                android:layout_toEndOf="@+id/tvMeetingDate"
                android:textColor="@color/black"
                android:textSize="@dimen/_12sdp" />

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/ivDatePicker"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:layout_marginEnd="@dimen/_10sdp"
                app:srcCompat="@drawable/ic_calendar" />

        </RelativeLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_2sdp"
            android:layout_marginTop="@dimen/_5sdp"
            android:text="@string/txt_lable_product"
            android:visibility="gone"
            android:textColor="@color/text_color_personal"
            android:textSize="@dimen/_11sdp" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_product"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_5sdp"
            app:errorTextAppearance="@style/error_appearance"
            app:hintEnabled="false">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_product"
                style="@style/EditTextHint"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_22sdp"
                android:hint="@string/txt_lable_product" />

            <Spinner
                android:id="@+id/spProduct"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </com.google.android.material.textfield.TextInputLayout>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvProductList"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
        </RelativeLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_2sdp"
            android:layout_marginTop="@dimen/_5sdp"
            android:visibility="gone"
            android:text="@string/txt_lable_meeting_duration"
            android:textColor="@color/text_color_personal"
            android:textSize="@dimen/_11sdp" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_meeting_duration"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_5sdp"
            app:errorTextAppearance="@style/error_appearance"
            app:hintEnabled="false">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_meeting_duration"
                style="@style/EditTextHint"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_22sdp"
                android:hint="@string/txt_lable_meeting_duration" />

            <Spinner
                android:id="@+id/spMeetingDuration"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_2sdp"
            android:layout_marginTop="@dimen/_5sdp"
            android:visibility="gone"
            android:text="@string/txt_lable_meeting_objective"
            android:textColor="@color/text_color_personal"
            android:textSize="@dimen/_11sdp" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_meeting_objective"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_5sdp"
            app:errorTextAppearance="@style/error_appearance"
            app:hintEnabled="false">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_meeting_objective"
                style="@style/EditTextHint"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_22sdp"
                android:hint="@string/txt_lable_meeting_objective" />

            <Spinner
                android:id="@+id/spMeetingObjective"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </com.google.android.material.textfield.TextInputLayout>


        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_2sdp"
            android:layout_marginTop="@dimen/_5sdp"
            android:visibility="gone"
            android:text="@string/txt_lable_meeting_reason"
            android:textColor="@color/text_color_personal"
            android:textSize="@dimen/_11sdp" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_meeting_reason"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_5sdp"
            app:hintEnabled="false">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_meeting_reason"
                style="@style/EditTextHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/txt_lable_meeting_reason" />
            <Spinner
                android:id="@+id/spMeetingReason"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:entries="@array/Select_Meeting_Reason" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_touched_untouched"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_5sdp"
            app:hintEnabled="false"
            android:visibility="gone">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_touched_untouched"
                style="@style/EditTextHint"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_22sdp"
                android:hint="@string/txt_lable_touched_untouched" />
            <Spinner
                android:id="@+id/spTouchedUntouched"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_feedback"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_5sdp"
            app:hintEnabled="false"
            android:visibility="gone">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_feedback"
                style="@style/EditTextHint"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_22sdp"
                android:hint="@string/txt_lable_feedback" />
            <Spinner
                android:id="@+id/spFeedback"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_3sdp"
            app:errorTextAppearance="@style/error_appearance">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etMeetingDescription"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_80sdp"
                android:digits="ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789 ,@!#&amp;()_."
                android:hint="@string/hint_lable_enter_meeting_description"
                android:inputType="textMultiLine"
                android:maxLength="500"
                android:textCursorDrawable="@null" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_meeting_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:errorTextAppearance="@style/error_appearance"
            app:hintEnabled="false" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_10sdp"
            android:background="@drawable/list_bacground"
            android:orientation="vertical">

            <RelativeLayout
                android:id="@+id/llAttendee"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/tvAttendee"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:paddingStart="@dimen/_3sdp"
                    android:paddingTop="@dimen/_10sdp"
                    android:paddingBottom="@dimen/_10sdp"
                    android:text="@string/txt_lable_attendee"
                    android:textColor="@color/black"
                    android:textSize="@dimen/_12sdp" />

                <TextView
                    android:id="@+id/tvAttendeeCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_toEndOf="@+id/tvAttendee"
                    android:paddingStart="@dimen/_5sdp"
                    android:paddingTop="@dimen/_10sdp"
                    android:paddingBottom="@dimen/_10sdp"
                    android:textColor="@color/black"
                    android:textSize="@dimen/_12sdp" />

                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/ibAttendee"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerInParent="true"
                    android:background="@color/white"
                    android:src="@drawable/ic_plus" />

            </RelativeLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/calendar_gray" />

            <RelativeLayout
                android:id="@+id/llSplAttendee"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/tvSplAttendee"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:paddingStart="@dimen/_3sdp"
                    android:paddingTop="@dimen/_10sdp"
                    android:paddingBottom="@dimen/_10sdp"
                    android:text="@string/txt_lable_spl_attendee"
                    android:textColor="@color/black"
                    android:textSize="@dimen/_12sdp" />

                <TextView
                    android:id="@+id/tvSplAttendeeCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_toEndOf="@+id/tvSplAttendee"
                    android:paddingStart="@dimen/_5sdp"
                    android:paddingTop="@dimen/_10sdp"
                    android:paddingBottom="@dimen/_10sdp"
                    android:textColor="@color/black"
                    android:textSize="@dimen/_12sdp" />

                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/ibSplAttendee"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerInParent="true"
                    android:background="@color/white"
                    android:src="@drawable/ic_plus" />

            </RelativeLayout>

        </LinearLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_3sdp"
            app:hintTextAppearance="@style/InputLayout">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etCustomerComment"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_80sdp"
                android:digits="ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789 ,@!#&amp;()_"
                android:hint="@string/hint_lable_enter_customer_comment"
                android:inputType="textMultiLine"
                android:textCursorDrawable="@null" />
        </com.google.android.material.textfield.TextInputLayout>

        <LinearLayout
            android:id="@+id/llLocationGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvMeetingLocation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Meeting Location*"
                android:visibility="gone"
                android:textColor="@color/text_color_personal"
                android:textSize="@dimen/_11sdp" />
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_meeting_location"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_5sdp"
                app:errorTextAppearance="@style/error_appearance"
                app:hintEnabled="false">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_meeting_location"
                    style="@style/EditTextHint"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_22sdp"
                    android:hint="Meeting Location*" />

                <Spinner
                    android:id="@+id/spMeetingLocation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:entries="@array/Select" />
            </com.google.android.material.textfield.TextInputLayout>
            <TextView
                android:id="@+id/tvTravellingMode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:text="@string/txt_lable_travelling_mode"
                android:textColor="@color/text_color_personal"
                android:textSize="@dimen/_11sdp" />
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_travelling_mode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_5sdp"
                app:errorTextAppearance="@style/error_appearance"
                app:hintEnabled="false">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_travelling_mode"
                    style="@style/EditTextHint"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_22sdp"
                    android:hint="@string/txt_lable_travelling_mode" />

                <Spinner
                    android:id="@+id/spTravellingMode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:entries="@array/Select" />

            </com.google.android.material.textfield.TextInputLayout>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvTravellingList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_amount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_3sdp"
                app:hintTextAppearance="@style/InputLayout">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etAmount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/txt_lable_enter_amount"
                    android:inputType="number"
                    android:maxLength="4"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:textCursorDrawable="@null"

                    />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_3sdp"
                android:id="@+id/tilMeetingAddress"
                app:errorTextAppearance="@style/error_appearance">
                <com.google.android.material.textfield.TextInputEditText
                    style="@style/EditTextHint"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_22sdp"
                    android:hint="@string/txt_lable_meeting_address"
                    />

                <TextView
                    android:id="@+id/etLocation"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_60sdp"
                    android:digits="ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789 ,@!#&amp;()_"
                    android:inputType="textMultiLine"
                    android:maxLines="6"
                    android:clickable="true"
                    android:focusable="false"
                    android:padding="3dp"
                    android:background="@color/white"
                    android:scrollHorizontally="false"
                    android:scrollbars="vertical"
                    android:gravity="top|left"
                    android:textSize="18dp"
                    android:textCursorDrawable="@null" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_location"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:errorTextAppearance="@style/error_appearance"
                app:hintEnabled="false" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_3sdp"
                app:hintTextAppearance="@style/InputLayout">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etPinCode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/txt_lable_enter_pincode"
                    android:inputType="number"
                    android:maxLength="6"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:textCursorDrawable="@null" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_pinCode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:errorTextAppearance="@style/error_appearance"
                app:hintEnabled="false" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/lnrLeadStageDetail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="visible">
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_stage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:errorTextAppearance="@style/error_appearance"
                app:hintEnabled="false">

            <TextView
                android:id="@+id/tvStage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/text_lead_creation_stage"
                android:layout_marginLeft="5dp"
                android:textColor="@color/text_color_personal"
                android:textSize="@dimen/_11sdp" />

            <Spinner
                android:id="@+id/spStage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_3sdp" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:errorTextAppearance="@style/error_appearance"
                app:hintEnabled="false">
            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/text_lead_creation_status_compulsory"
                android:textColor="@color/text_color_personal"
                android:textSize="@dimen/_11sdp"
                android:layout_marginLeft="5dp"/>


            <Spinner
                android:id="@+id/spStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_3sdp" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/tvActionables"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_6sdp"
            android:background="@color/white"
            android:ellipsize="end"
            android:padding="8dp"
            android:singleLine="true"
            android:text="@string/txt_lable_actionables"
            android:textAppearance="?android:attr/textAppearanceLarge"
            android:textSize="@dimen/_14sdp"
            android:visibility="gone" />


        <LinearLayout
            android:id="@+id/llActionables"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_5sdp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_2sdp"
                android:layout_marginTop="@dimen/_5sdp"
                android:text="@string/txt_lable_actionables"
                android:textColor="@color/text_color_personal"
                android:textSize="@dimen/_11sdp" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_actionables"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:errorTextAppearance="@style/error_appearance"
                app:hintEnabled="false">

                <Spinner
                    android:id="@+id/spActionables"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_2sdp"
                android:layout_marginTop="@dimen/_5sdp"
                android:text="@string/txt_lable_category"
                android:textColor="@color/text_color_personal"
                android:textSize="@dimen/_11sdp" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_category"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:errorTextAppearance="@style/error_appearance"
                app:hintEnabled="false">

                <Spinner
                    android:id="@+id/spCategory"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_5sdp" />
            </com.google.android.material.textfield.TextInputLayout>


            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_3sdp"
                app:errorTextAppearance="@style/error_appearance"
                app:hintTextAppearance="@style/InputLayout">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etCategory"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_80sdp"
                    android:digits="ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789 ,@!#&amp;()_"
                    android:hint="@string/hint_lable_enter_category_description"
                    android:inputType="textMultiLine"
                    android:maxLength="500"
                    android:overScrollMode="always"
                    android:scrollbarStyle="insideInset"
                    android:scrollbars="vertical"
                    android:textCursorDrawable="@null" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_et_category"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:errorTextAppearance="@style/error_appearance"
                app:hintEnabled="false" />

            <LinearLayout
                android:id="@+id/llSubcategory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_2sdp"
                    android:layout_marginTop="@dimen/_5sdp"
                    android:text="@string/txt_lable_sub_category"
                    android:textColor="@color/text_color_personal"
                    android:textSize="@dimen/_11sdp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_sub_category"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:errorTextAppearance="@style/error_appearance"
                    app:hintEnabled="false">

                    <Spinner
                        android:id="@+id/spSubCategory"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                </com.google.android.material.textfield.TextInputLayout>


                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_3sdp"
                    app:errorTextAppearance="@style/error_appearance"
                    app:hintTextAppearance="@style/InputLayout">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etSubCategory"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_80sdp"
                        android:digits="ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789 ,@!#&amp;()_"
                        android:hint="@string/enter_txt_lable_sub_category_description"
                        android:inputType="textMultiLine"
                        android:maxLength="500"
                        android:overScrollMode="always"
                        android:scrollbarStyle="insideInset"
                        android:scrollbars="vertical"
                        android:textCursorDrawable="@null" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_et_sub_category"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:errorTextAppearance="@style/error_appearance"
                    app:hintEnabled="false" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_10sdp"
            android:layout_marginBottom="@dimen/_10sdp"
            android:gravity="center_horizontal">

            <Button
                android:id="@+id/btnSave"
                android:layout_width="@dimen/_60sdp"
                android:layout_height="@dimen/_30sdp"
                android:text="@string/btn_lable_save"
                android:textColor="@color/white" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnReset"
                android:layout_width="@dimen/_60sdp"
                android:layout_height="@dimen/_30sdp"
                android:layout_marginStart="@dimen/_10sdp"
                android:background="@color/calendar_gray2"
                android:text="@string/btn_lable_reset"
                android:textColor="@color/black" />
        </LinearLayout>

    </LinearLayout>

</ScrollView>