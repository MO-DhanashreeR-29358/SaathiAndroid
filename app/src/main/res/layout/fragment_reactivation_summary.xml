<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".reactivation.summary.ReactivationSummaryFragment"
    >

    <RelativeLayout
        android:id="@+id/labelContainer"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_35sdp"
        android:background="@color/titleBarBackground"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/txtLables"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:layout_marginStart="@dimen/_5sdp"
            android:singleLine="true"
            android:text="Reactivation Assigned Clients"
            android:textColor="@color/alternateTextColor"
            android:textSize="@dimen/appTitleTextSize"
            android:textStyle="bold" />
    </RelativeLayout>

    <TextView
        android:id="@+id/txtFilter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/labelContainer"
        android:text="Period"
        android:textSize="@dimen/_15sdp"
        android:layout_marginTop="@dimen/_10sdp"
        android:padding="@dimen/_10sdp">
    </TextView>

    <Spinner
        android:id="@+id/sp_period"
        style="@style/DashbordSpinnerSelector"
        android:layout_width="@dimen/_150sdp"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toEndOf="@+id/txtFilter"
        app:layout_constraintTop_toTopOf="@+id/txtFilter"
        app:layout_constraintBottom_toBottomOf="@+id/txtFilter"/>

    <TextView
        android:id="@+id/txtSource"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/txtFilter"
        android:text="Source"
        android:textSize="@dimen/_15sdp"
        android:layout_marginTop="@dimen/_10sdp"
        android:padding="@dimen/_10sdp">
    </TextView>

    <Spinner
        android:id="@+id/sp_source"
        style="@style/DashbordSpinnerSelector"
        android:layout_width="@dimen/_150sdp"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toEndOf="@+id/txtSource"
        app:layout_constraintTop_toTopOf="@+id/txtSource"
        app:layout_constraintBottom_toBottomOf="@+id/txtSource"/>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnSearch"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/button_highlight"
        android:text="@string/str_search"
        app:layout_constraintEnd_toEndOf="parent"
        android:paddingLeft="5dp"
        android:paddingRight="5dp"
        android:layout_marginRight="10dp"
        app:layout_constraintBottom_toBottomOf="@+id/sp_source"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/txtSource"
        android:layout_marginTop="@dimen/_10sdp">

        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:background="@color/gray_light">
        </View>

        <LinearLayout
            android:id="@+id/assigned_container"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@color/light_grey_menu">
            <TextView
                android:layout_width="@dimen/_150sdp"
                android:layout_height="match_parent"
                android:text="Assigned"
                android:paddingStart="@dimen/_10sdp"
                android:gravity="center_vertical"
                android:textSize="@dimen/_15sdp">
            </TextView>
            <TextView
                android:id="@+id/tvAssigned"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="0"
                android:gravity="center"
                android:textColor="@color/black"
                android:textStyle="bold"
                android:textSize="@dimen/_15sdp">
            </TextView>

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:background="@color/gray_light">
        </View>

        <LinearLayout
            android:id="@+id/contacted_container"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@color/white">
            <TextView
                android:layout_width="@dimen/_150sdp"
                android:layout_height="match_parent"
                android:text="Contacted"
                android:paddingStart="@dimen/_10sdp"
                android:gravity="center_vertical"
                android:textSize="@dimen/_15sdp">
            </TextView>
            <TextView
                android:id="@+id/tvContacted"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="0"
                android:gravity="center"
                android:textColor="@color/black"
                android:textStyle="bold"
                android:textSize="@dimen/_15sdp">
            </TextView>

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:background="@color/gray_light">
        </View>

        <LinearLayout
            android:id="@+id/non_contacted_container"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@color/light_grey_menu">
            <TextView
                android:layout_width="@dimen/_150sdp"
                android:layout_height="match_parent"
                android:text="Not Contacted"
                android:gravity="center_vertical"
                android:paddingStart="@dimen/_10sdp"
                android:textSize="@dimen/_15sdp">
            </TextView>
            <TextView
                android:id="@+id/tvNonContacted"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="0"
                android:gravity="center"
                android:textColor="@color/black"
                android:textStyle="bold"
                android:textSize="@dimen/_15sdp">
            </TextView>

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:background="@color/gray_light">
        </View>

        <LinearLayout
            android:id="@+id/reactivated_clients_container"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@color/white">
            <TextView
                android:layout_width="@dimen/_150sdp"
                android:layout_height="match_parent"
                android:text="Reactivated Clients"
                android:paddingStart="@dimen/_10sdp"
                android:gravity="center_vertical"
                android:textSize="@dimen/_15sdp">
            </TextView>
            <TextView
                android:id="@+id/tvReactivatedClients"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="0"
                android:gravity="center"
                android:textColor="@color/black"
                android:textStyle="bold"
                android:textSize="@dimen/_15sdp">
            </TextView>

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:background="@color/gray_light">
        </View>

        <LinearLayout
            android:id="@+id/traded_container"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@color/light_grey_menu">
            <TextView
                android:layout_width="@dimen/_150sdp"
                android:layout_height="match_parent"
                android:text="Traded"
                android:gravity="center_vertical"
                android:paddingStart="@dimen/_10sdp"
                android:textSize="@dimen/_15sdp">
            </TextView>
            <TextView
                android:id="@+id/tvTraded"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="0"
                android:gravity="center"
                android:textColor="@color/black"
                android:textStyle="bold"
                android:textSize="@dimen/_15sdp">
            </TextView>

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:background="@color/gray_light">
        </View>

        <LinearLayout
            android:id="@+id/revenue_container"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@color/white">
            <TextView
                android:layout_width="@dimen/_150sdp"
                android:layout_height="match_parent"
                android:text="Revenue"
                android:gravity="center_vertical"
                android:paddingStart="@dimen/_10sdp"
                android:textSize="@dimen/_15sdp">
            </TextView>
            <TextView
                android:id="@+id/tvRevenue"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="0"
                android:gravity="center"
                android:textColor="@color/black"
                android:textStyle="bold"
                android:textSize="@dimen/_15sdp">
            </TextView>

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:background="@color/gray_light">
        </View>

    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>