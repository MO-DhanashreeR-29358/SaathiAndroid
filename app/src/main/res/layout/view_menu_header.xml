<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    >
  <androidx.constraintlayout.widget.ConstraintLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:background="@color/menu_header_background_color"
      android:paddingTop="48dp"
      >
    <ImageView
        android:id="@+id/imgClose"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginEnd="@dimen/margin_medium"
        android:src="@drawable/ic_close"
        app:layout_constraintBottom_toTopOf="@id/txtPartnerName"
        app:layout_constraintEnd_toEndOf="parent"
        />
    <de.hdodenhof.circleimageview.CircleImageView
        android:id="@+id/imgPartner"
        android:layout_width="@dimen/menu_icons_size"
        android:layout_height="@dimen/menu_icons_size"
        android:layout_marginStart="@dimen/margin_medium"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        />

    <TextView
        android:id="@+id/txtPartnerName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="@dimen/padding_medium"
        android:textColor="@color/white"
        android:textSize="@dimen/text_size_medium"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@id/txtBusinessProfileName"
        app:layout_constraintStart_toEndOf="@id/imgPartner"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="Suman Roy"
        />

    <TextView
        android:id="@+id/txtBusinessProfileName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingBottom="@dimen/padding_medium"
        android:paddingEnd="@dimen/padding_medium"
        android:paddingStart="@dimen/padding_medium"
        android:textColor="@color/white"
        android:textSize="@dimen/text_size_medium"
        android:textStyle="bold"
        app:layout_constraintStart_toEndOf="@id/imgPartner"
        app:layout_constraintTop_toBottomOf="@id/txtPartnerName"
        tools:text="Retail Branch Manager"
        />
  </androidx.constraintlayout.widget.ConstraintLayout>
</layout>