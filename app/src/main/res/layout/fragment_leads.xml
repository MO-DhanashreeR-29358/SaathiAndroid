<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/dashboard_background"
        android:paddingStart="@dimen/margin_medium"
        android:paddingEnd="@dimen/margin_medium">


        <Spinner
            android:id="@+id/sp_period"
            style="@style/DashbordSpinnerSelector"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_small"
            app:layout_constraintEnd_toStartOf="@+id/sp_product"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />


        <Spinner
            android:id="@+id/sp_product"
            style="@style/DashbordSpinnerSelector"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_small"
            android:layout_marginTop="@dimen/margin_small"
            android:visibility="gone"
            app:layout_constraintEnd_toStartOf="@+id/sp_source"
            app:layout_constraintStart_toEndOf="@+id/sp_period"
            app:layout_constraintTop_toTopOf="parent" />

        <Spinner
            android:id="@+id/sp_source"
            style="@style/DashbordSpinnerSelector"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_small"
            android:layout_marginTop="@dimen/margin_small"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/sp_product"
            app:layout_constraintTop_toTopOf="parent" />


        <Spinner
            android:id="@+id/sp_bank"
            style="@style/DashbordSpinnerSelector"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_small"
            app:layout_constraintEnd_toStartOf="@+id/sp_branch"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/sp_period" />


        <Spinner
            android:id="@+id/sp_branch"
            style="@style/DashbordSpinnerSelector"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_small"
            android:layout_marginTop="@dimen/margin_small"
            app:layout_constraintEnd_toStartOf="@+id/sp_sub_branch"
            app:layout_constraintStart_toEndOf="@+id/sp_bank"
            app:layout_constraintTop_toBottomOf="@+id/sp_period" />

        <Spinner
            android:id="@+id/sp_sub_branch"
            style="@style/DashbordSpinnerSelector"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_small"
            android:layout_marginTop="@dimen/margin_small"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/sp_branch"
            app:layout_constraintTop_toBottomOf="@+id/sp_period" />

        <androidx.constraintlayout.widget.Group
            android:id="@+id/bank_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:constraint_referenced_ids="sp_bank,sp_branch,sp_sub_branch" />

        <include
            android:id="@+id/include_chart"
            layout="@layout/include_leads_chart"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/margin_small"
            app:layout_constraintTop_toBottomOf="@+id/sp_bank" />


    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>