<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:fab="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorWhite"
    >


    <ScrollView
        android:id="@id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingBottom="@dimen/_20sdp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            >
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2">
                <Spinner
                    android:id="@+id/sp_filter_period"
                    style="@style/DashbordSpinnerSelector"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_8sdp"
                    android:layout_marginEnd="@dimen/margin_small" />
                <Spinner
                    android:id="@+id/sp_filter_advisor"
                    style="@style/DashbordSpinnerSelector"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_8sdp"
                    android:layout_marginEnd="@dimen/margin_small" />

            </LinearLayout>


            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/_35sdp"
                android:background="@color/secondaryBackground"
                >

                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:layout_toStartOf="@+id/txtTarget"
                    app:srcCompat="@drawable/ic_target_achievement"
                    />

                <TextView
                    android:id="@+id/txtTarget"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:layout_marginStart="@dimen/_5sdp"
                    android:singleLine="true"
                    android:text="Target Vs Achievement"
                    android:textColor="@color/alternateTextColor"
                    android:textSize="@dimen/appTitleTextSize"
                    android:textStyle="bold" />



            </RelativeLayout>

            <!-- Target vs Achievement-->
            <LinearLayout
                android:id="@+id/llMeetingSum"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="visible"
                >

                <RelativeLayout
                    android:id="@+id/rlMeetSumADV"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_35sdp"
                    android:background="@color/titleBarBackground"
                    >


                    <TextView
                        android:id="@+id/txtMeetSum"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerInParent="true"
                        android:layout_marginStart="@dimen/_5sdp"
                        android:singleLine="true"
                        android:text="Meeting Summary"
                        android:textColor="@color/alternateTextColor"
                        android:textSize="@dimen/appTitleTextSize"
                        android:textStyle="bold" />

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/ivMeetSumADV"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:layout_marginEnd="@dimen/_3sdp"
                        android:src="@drawable/minus"
                        />

                </RelativeLayout>


                <LinearLayout
                    android:id="@+id/llMeetSumADV"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    >

                </LinearLayout>

            </LinearLayout>


            <LinearLayout
                android:id="@+id/llMeetReachSum"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_5sdp"
                android:orientation="vertical"
                android:visibility="visible"
                >

                <RelativeLayout
                    android:id="@+id/rlMeetReachSumADV"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_35sdp"
                    android:background="@color/titleBarBackground"
                    >


                    <TextView
                        android:id="@+id/tvMeetReachSum"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerInParent="true"
                        android:layout_marginStart="@dimen/_5sdp"
                        android:singleLine="true"
                        android:text="Meeting Reach Summary"
                        android:textColor="@color/alternateTextColor"
                        android:textSize="@dimen/appTitleTextSize"
                        android:textStyle="bold" />

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/ivMeetReachSum"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:layout_marginEnd="@dimen/_3sdp"
                        android:src="@drawable/minus"/>
                </RelativeLayout>

                <LinearLayout
                    android:id="@+id/llMeetReachSumADV"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    >

                </LinearLayout>

            </LinearLayout>


        </LinearLayout>
    </ScrollView>


    <com.getbase.floatingactionbutton.FloatingActionsMenu
        android:id="@+id/floatingActionsMenu"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        fab:fab_addButtonColorNormal="@color/secondaryBackground"
        fab:fab_addButtonColorPressed="@color/white_pressed"
        fab:fab_addButtonPlusIconColor="@color/white"
        fab:fab_labelStyle="@style/menu_labels_style"
        >

        <com.getbase.floatingactionbutton.FloatingActionButton
            android:id="@+id/leadcreation"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:fab_icon="@drawable/ic_create_lead"
            fab:fab_colorNormal="#ffffff"
            fab:fab_colorPressed="#ffffff"
            fab:fab_size="mini"
            fab:fab_title="Create Lead"
            />
    </com.getbase.floatingactionbutton.FloatingActionsMenu>


</RelativeLayout>