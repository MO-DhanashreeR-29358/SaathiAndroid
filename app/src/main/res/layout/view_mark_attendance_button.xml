<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    >
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/mood_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        >
        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/emoji_happy"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:layout_marginTop="8dp"
            android:layout_weight="1"
            android:scaleType="fitCenter"
            app:layout_constraintEnd_toStartOf="@+id/emoji_excited"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"

            />
        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/emoji_excited"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:layout_marginTop="8dp"
            android:layout_weight="1"
            android:scaleType="fitCenter"
            app:layout_constraintEnd_toStartOf="@+id/emoji_sad"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toEndOf="@+id/emoji_happy"
            app:layout_constraintTop_toTopOf="parent"
            />
        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/emoji_sad"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:layout_marginTop="8dp"
            android:layout_weight="1"
            android:scaleType="fitCenter"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/emoji_excited"
            app:layout_constraintTop_toTopOf="parent"
            />

        <TextView
            android:id="@+id/txt_excited"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Happy"
            android:textAlignment="center"
            android:textColor="@color/text_color_secondary_black"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="@+id/emoji_happy"
            app:layout_constraintStart_toStartOf="@+id/emoji_happy"
            app:layout_constraintTop_toBottomOf="@+id/emoji_happy"
            />
        <TextView
            android:id="@+id/txt_happy"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:text="Excited"
            android:textAlignment="center"
            android:textColor="@color/text_color_secondary_black"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="@+id/emoji_excited"
            app:layout_constraintStart_toStartOf="@+id/emoji_excited"
            app:layout_constraintTop_toBottomOf="@+id/emoji_excited"
            />
        <TextView
            android:id="@+id/txt_sad"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Sad"
            android:textAlignment="center"
            android:textColor="@color/text_color_secondary_black"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="@+id/emoji_sad"
            app:layout_constraintStart_toStartOf="@+id/emoji_sad"
            app:layout_constraintTop_toBottomOf="@+id/emoji_sad"
            />
        <View
            android:id="@+id/view_attendance_div"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_gravity="center"
            android:layout_marginTop="8dp"
            android:background="@color/alternate_background"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/txt_excited"
            />
        <TextView
            android:id="@+id/textView13"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_marginStart="8dp"
            android:layout_marginTop="8dp"
            android:text="@string/select_your_mood_for_sign_in"
            android:textAlignment="center"
            android:textAppearance="@style/TextAppearance.AppCompat.Large"
            android:textColor="@color/text_color_header"
            android:textStyle="bold|italic"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/view_attendance_div"
            />
    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>