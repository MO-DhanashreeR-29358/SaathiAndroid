<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">


    <LinearLayout
        android:id="@+id/linearLayoutTeam"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="2dp"
        android:orientation="horizontal">

        <RelativeLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.3">

        </RelativeLayout>

        <Spinner
            android:id="@+id/spPeriod"
            style="@style/DashbordSpinnerSelector"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_8sdp"
            android:layout_weight="1" />

        <RelativeLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.3">

        </RelativeLayout>

    </LinearLayout>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

      <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/horizontalRecyclerView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/_5sdp" />
    </RelativeLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/_8sdp"
        android:background="@color/white"
        android:orientation="vertical">


        <LinearLayout
            android:id="@+id/llTopFirst"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="@dimen/_10sdp"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/linearLayoutLeft"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/txtLeftStr"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:textColor="@color/black"
                    android:textSize="@dimen/txt_size" />

                <TextView
                    android:id="@+id/txtLeftValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text=""
                    android:textColor="@color/flush_orange"
                    android:textSize="@dimen/txt_size" />
            </LinearLayout>


            <LinearLayout
                android:id="@+id/linearLayoutCenter"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:visibility="gone">

                <View
                    android:layout_width="@dimen/_2sdp"
                    android:layout_height="@dimen/_30sdp"
                    android:layout_gravity="center"
                    android:background="@color/view_grey"></View>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txtCenterStr"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginLeft="@dimen/_2sdp"
                        android:textColor="@color/black"
                        android:textSize="@dimen/txt_size" />

                    <TextView
                        android:id="@+id/txtCenterValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginLeft="@dimen/_2sdp"
                        android:text=""
                        android:textColor="@color/red"
                        android:textSize="@dimen/txt_size" />
                </LinearLayout>
            </LinearLayout>


            <LinearLayout
                android:id="@+id/linearLayoutRight"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:visibility="gone">


                <View
                    android:layout_width="@dimen/_2sdp"
                    android:layout_height="@dimen/_30sdp"
                    android:layout_gravity="center"
                    android:background="@color/view_grey"></View>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txtRightStr"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginLeft="@dimen/_2sdp"
                        android:text="Unique"
                        android:textColor="@color/black"
                        android:textSize="@dimen/txt_size" />

                    <TextView
                        android:id="@+id/txtRightValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginLeft="@dimen/_2sdp"
                        android:text=""
                        android:textColor="@color/green_textcolor"
                        android:textSize="@dimen/txt_size" />

                </LinearLayout>
            </LinearLayout>

        </LinearLayout>

        <ImageView
            android:id="@+id/ivView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:src="@drawable/horizontal_line" />


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="@dimen/_10sdp">

            <LinearLayout
                android:id="@+id/llFirst"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:visibility="visible">


                <TextView
                    android:id="@+id/tvUniqueLeadsFirst"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="@dimen/_5sdp"
                    android:text=""
                    android:textColor="@color/black"
                    android:textSize="@dimen/_12sdp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <view
                            android:id="@+id/pieChartFirst"
                            class="com.mosl.tabapp.common.LockedPieChart"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/_150sdp"
                            android:layout_centerHorizontal="true"
                            android:layout_marginTop="@dimen/_minus10sdp" />

                      <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/ivLeftArrowFirst"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentLeft="true"
                            android:padding="@dimen/_4sdp"
                            android:layout_marginTop="@dimen/_56sdp"
                            app:srcCompat="@drawable/ic_left_arrow" />

                      <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/ivRightArrowFirst"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentRight="true"
                            android:padding="@dimen/_4sdp"
                            android:layout_marginTop="@dimen/_56sdp"
                          app:srcCompat="@drawable/ic_new_right_arrow_gray"
                          />

                      <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/verticalRecyclerViewFirst"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_below="@+id/pieChartFirst"
                            android:layout_margin="@dimen/_3sdp"
                            tools:listitem="@layout/item_target_achievement_dynamic_list" />

                        <TextView
                            android:id="@+id/tvErrorFirst"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerInParent="true"
                            android:text="@string/NO_DATA_FOUND"
                            android:visibility="gone" />
                    </RelativeLayout>

                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/llSecond"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:visibility="gone">


                <TextView
                    android:id="@+id/tvUniqueLeadsSecond"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="@dimen/_5sdp"
                    android:text=""
                    android:textColor="@color/black"
                    android:textSize="@dimen/_12sdp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <view
                            android:id="@+id/pieChartSecond"
                            class="com.mosl.tabapp.common.LockedPieChart"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/_150sdp"
                            android:layout_centerHorizontal="true"
                            android:layout_marginTop="@dimen/_minus10sdp" />

                      <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/ivLeftArrowSecond"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentLeft="true"
                            android:padding="@dimen/_4sdp"
                            android:layout_marginTop="@dimen/_56sdp"
                            app:srcCompat="@drawable/ic_left_arrow" />

                      <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/ivRightArrowSecond"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentRight="true"
                            android:padding="@dimen/_4sdp"
                            android:layout_marginTop="@dimen/_56sdp"
                          app:srcCompat="@drawable/ic_new_right_arrow_gray"
                          />

                      <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/verticalRecyclerViewSecond"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_below="@+id/pieChartSecond"
                            android:layout_margin="@dimen/_3sdp"
                            tools:listitem="@layout/item_target_achievement_dynamic_list" />

                        <TextView
                            android:id="@+id/tvErrorSecond"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerInParent="true"
                            android:text="@string/NO_DATA_FOUND"
                            android:visibility="gone" />
                    </RelativeLayout>


                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/llThird"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvUniqueLeadsThird"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="@dimen/_5sdp"
                    android:text=""
                    android:textColor="@color/black"
                    android:textSize="@dimen/_12sdp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <view
                            android:id="@+id/pieChartThird"
                            class="com.mosl.tabapp.common.LockedPieChart"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/_150sdp"
                            android:layout_centerHorizontal="true"
                            android:layout_marginTop="@dimen/_minus10sdp" />

                      <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/ivLeftArrowThird"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentLeft="true"
                            android:padding="@dimen/_4sdp"
                            android:layout_marginTop="@dimen/_56sdp"
                            app:srcCompat="@drawable/ic_left_arrow" />

                      <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/ivRightArrowThird"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentRight="true"
                            android:padding="@dimen/_4sdp"
                            android:layout_marginTop="@dimen/_56sdp"
                          app:srcCompat="@drawable/ic_new_right_arrow_gray"
                          />

                      <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/verticalRecyclerViewThird"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_below="@+id/pieChartThird"
                            android:layout_margin="@dimen/_3sdp"
                            tools:listitem="@layout/item_target_achievement_dynamic_list" />

                        <TextView
                            android:id="@+id/tvErrorThird"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerInParent="true"
                            android:text="@string/NO_DATA_FOUND"
                            android:visibility="gone" />
                    </RelativeLayout>


                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>