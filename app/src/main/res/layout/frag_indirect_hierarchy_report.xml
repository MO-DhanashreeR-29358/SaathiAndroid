<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@color/white"
  android:orientation="vertical">

  <RelativeLayout
      android:id="@+id/labelContainer"
    android:layout_width="match_parent"
    android:layout_height="@dimen/_35sdp"
    android:background="@color/titleBarBackground">

    <TextView
      android:id="@+id/txtLables"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_centerInParent="true"
      android:layout_marginStart="@dimen/_5sdp"
      android:singleLine="true"
      android:textColor="@color/alternateTextColor"
      android:textSize="@dimen/appTitleTextSize"
      android:textStyle="bold" />
  </RelativeLayout>

  <LinearLayout
    android:id="@+id/linearLayout"
    android:layout_width="match_parent"
    android:layout_height="@dimen/_40sdp"
    android:layout_marginLeft="@dimen/_5sdp"
    android:layout_marginTop="@dimen/_10sdp"
    android:layout_marginRight="@dimen/_5sdp"
    android:background="@color/dashboard_background"
    android:orientation="horizontal"
    android:visibility="gone">

    <Spinner
      android:id="@+id/sp_period"
      android:layout_width="0dp"
      android:layout_height="match_parent"
      android:layout_margin="@dimen/_5sdp"
      android:layout_weight="1"
      android:visibility="gone" />

    <Spinner
      android:id="@+id/sp_type"
      android:layout_width="0dp"
      android:layout_height="match_parent"
      android:layout_margin="@dimen/_5sdp"
      android:layout_weight="1"
      android:visibility="gone" />

    <RelativeLayout
      android:id="@+id/rlDate"
      android:layout_width="0dp"
      android:layout_height="@dimen/_30sdp"
      android:layout_margin="@dimen/_5sdp"
      android:layout_weight="1"
      android:background="@drawable/list_bacground"
      android:visibility="gone">

      <TextView
        android:id="@+id/tvDate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_marginStart="@dimen/_5sdp"
        android:textColor="@color/black"
        android:textSize="@dimen/_12sdp" />

      <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ivDatePicker"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:layout_marginEnd="@dimen/_10sdp"
        app:srcCompat="@drawable/ic_calendar" />

    </RelativeLayout>


  </LinearLayout>

  <LinearLayout
      android:id="@+id/mainContainer"
      android:orientation="vertical"
      android:layout_width="match_parent"
      android:layout_height="50dp"
      android:layout_gravity="center"
      android:background="@color/orange"
      android:layout_below="@+id/labelContainer">
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/gray_light"></View>

    <RelativeLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical">
      <!-- Toggle button for expand/collapse -->
      <View
          android:layout_width="1dp"
          android:layout_height="match_parent"
          android:background="@color/gray_light"
          android:layout_toStartOf="@+id/revenue"></View>


      <TextView
          android:id="@+id/salesRMName"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:text="Employee Name"
          android:textSize="16sp"
          android:textColor="@color/black"
          android:layout_centerVertical="true"
          android:gravity="center"
          android:layout_toStartOf="@+id/revenueDivider"/>
      <View
          android:id="@+id/revenueDivider"
          android:layout_width="1dp"
          android:layout_height="match_parent"
          android:background="@color/gray_light"
          android:layout_toStartOf="@+id/revenue"></View>
      <TextView
          android:id="@+id/revenue"
          android:layout_width="100dp"
          android:layout_height="wrap_content"
          android:textColor="@color/black"
          android:text="Revenue"
          android:gravity="right"
          android:layout_centerVertical="true"
          android:layout_marginEnd="5dp"
          android:layout_toStartOf="@+id/lastDivider"/>
      <View
          android:id="@+id/lastDivider"
          android:layout_width="1dp"
          android:layout_height="match_parent"
          android:background="@color/gray_light"
          android:layout_alignParentEnd="true"
          ></View>

    </RelativeLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/gray_light"></View>

  </LinearLayout>
  <ProgressBar
      android:id="@+id/circularProgressBar"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_centerInParent="true"
      android:indeterminate="true"
      android:progressDrawable="@drawable/circular_progressbar"
      android:visibility="visible"
      />


  <androidx.recyclerview.widget.RecyclerView
      android:id="@+id/recyclerView"
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:visibility="gone"
      android:layout_below="@+id/mainContainer"/>

</RelativeLayout>
