<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    >
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        >
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/background_color_query"

            >
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="@dimen/padding_large"
                >
                <Button
                    android:id="@+id/btn_submit"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_medium"
                    android:text="@string/btn_submit"
                    android:textColor="@color/white"
                    app:layout_constraintEnd_toStartOf="@+id/btn_reset"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/et_branch_code"
                    />
                <Button
                    android:id="@+id/btn_reset"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_medium"
                    android:text="@string/btn_reset"
                    android:layout_marginLeft="@dimen/_10sdp"
                    android:textColor="@color/white"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/btn_submit"
                    app:layout_constraintTop_toBottomOf="@+id/et_branch_code"
                    />

                <EditText
                    android:id="@+id/et_query_description"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/query_background"
                    android:gravity="start"
                    android:hint="@string/text_label_query_description"
                    android:inputType="textMultiLine"
                    android:minLines="3"
                    android:paddingLeft="@dimen/margin_extra_small"
                    android:paddingRight="@dimen/margin_extra_small"
                    android:textSize="@dimen/text_size_normal"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/txt_query_description"
                    style="@style/edittextSelector"
                    />

                <EditText
                    android:id="@+id/et_partner_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/query_background"
                    android:enabled="false"
                    android:paddingLeft="@dimen/margin_extra_small"
                    android:paddingRight="@dimen/margin_extra_small"
                    android:textSize="@dimen/text_size_normal"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/txt_partner_name"
                    style="@style/edittextSelector"
                    />

                <EditText
                    android:id="@+id/et_email_address"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/query_background"
                    android:enabled="false"
                    android:paddingLeft="@dimen/margin_extra_small"
                    android:paddingRight="@dimen/margin_extra_small"
                    android:textSize="@dimen/text_size_normal"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/txt_email_address"
                    style="@style/edittextSelector"
                    />

                <EditText
                    android:id="@+id/et_mobile_number"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/query_background"
                    android:enabled="false"
                    android:paddingLeft="@dimen/margin_extra_small"
                    android:paddingRight="@dimen/margin_extra_small"
                    android:textSize="@dimen/text_size_normal"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/txt_mobile_number"
                    style="@style/edittextSelector"
                    />

                <EditText
                    android:id="@+id/et_branch_code"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/query_background"
                    android:enabled="false"
                    android:paddingLeft="@dimen/margin_extra_small"
                    android:paddingRight="@dimen/margin_extra_small"
                    android:textSize="@dimen/text_size_normal"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/txt_branch_code"
                    style="@style/edittextSelector"
                    />

                <TextView
                    android:id="@+id/txt_query_description"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_medium"
                    android:text="@string/text_label_query_description"
                    android:textSize="@dimen/text_size_medium"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    />
                <TextView
                    android:id="@+id/txt_partner_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_large"
                    android:text="@string/text_label_partner_name"
                    android:textSize="@dimen/text_size_medium"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/et_query_description"
                    />

                <TextView
                    android:id="@+id/txt_email_address"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_large"
                    android:text="@string/text_label_email_address"
                    android:textSize="@dimen/text_size_medium"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/et_partner_name"
                    />

                <TextView
                    android:id="@+id/txt_mobile_number"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_large"
                    android:text="@string/text_label_mobile_number"
                    android:textSize="@dimen/text_size_medium"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/et_email_address"
                    />

                <TextView
                    android:id="@+id/txt_branch_code"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_large"
                    android:text="@string/text_label_branch_code"
                    android:textSize="@dimen/text_size_medium"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/et_mobile_number"
                    />

                <TextView
                    android:id="@+id/txt_contact_us"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_large"
                    android:drawablePadding="@dimen/padding_medium"
                    android:text="@string/text_label_contact_us"
                    android:textColor="@color/text_color_dark_orange"
                    android:textSize="@dimen/text_size_large"
                    android:textStyle="bold"
                    app:drawableStartCompat="@drawable/ic_contact_us"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/btn_submit"
                    />

                <TextView
                    android:id="@+id/txt_support_quotes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_normal"
                    android:text="@string/text_label_support_queries"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/txt_contact_us"
                    />

                <TextView
                    android:id="@+id/txt_tele_phone_1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/margin_medium"
                    android:layout_marginTop="@dimen/margin_medium"
                    android:text="@string/text_label_tele_phone_1"
                    android:textColor="@color/text_color_dark_orange"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/txt_support_quotes"
                    />

                <TextView
                    android:id="@+id/txt_tele_phone_2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/margin_medium"
                    android:layout_marginTop="@dimen/margin_medium"
                    android:text="@string/text_label_tele_phone_2"
                    android:textColor="@color/text_color_dark_orange"
                    android:textStyle="bold"
                    app:layout_constraintStart_toEndOf="@id/txt_tele_phone_1"
                    app:layout_constraintTop_toBottomOf="@+id/txt_support_quotes"
                    />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </ScrollView>
        <!--<com.mosl.partnersapp.views.InlineStateView
            android:id="@+id/view_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            />-->
    </FrameLayout>
</layout>