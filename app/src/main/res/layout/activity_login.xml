<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/branch_login"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_centerHorizontal="true"
        android:layout_centerVertical="true"
        android:orientation="vertical">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/_20sdp"
            android:layout_weight="0.3">

            <ImageView
                android:id="@+id/pulse_logo"
                android:layout_width="@dimen/_80sdp"
                android:layout_height="@dimen/_80sdp"
                android:layout_centerHorizontal="true"
                android:src="@drawable/app_icon" />
        </RelativeLayout>


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/_40sdp"
            android:layout_weight="1"
            android:orientation="vertical">

            <EditText
                android:id="@+id/etEmpCode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                android:layout_marginBottom="10dp"
                android:background="@drawable/login_edittext_border"
                android:drawableLeft="@drawable/login_user"
                android:drawablePadding="5dp"
                android:hint="Employee code"
                android:padding="@dimen/_10sdp"
                android:singleLine="true"
                android:textCursorDrawable="@null" />

            <EditText
                android:id="@+id/etPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                android:layout_marginBottom="10dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/login_edittext_border"
                android:drawableLeft="@drawable/login_paswrd"
                android:drawablePadding="10dp"
                android:ems="10"
                android:hint="Password"
                android:padding="@dimen/_10sdp"
                android:password="true"
                android:singleLine="true"
                android:imeOptions="actionDone"
                android:imeActionLabel="@string/show_login"
                android:textCursorDrawable="@null" />


            <Button
                android:id="@+id/btnLogin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/etPassword"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="10dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/login" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/customProgress"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#AA000000"
        android:clickable="true"
        android:gravity="top"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <fr.castorflex.android.smoothprogressbar.SmoothProgressBar
                android:id="@+id/pocket"
                style="@style/PocketProgressBar"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_4sdp"
                android:indeterminate="true" />

            <TextView
                android:id="@+id/progressTextview"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="Authenticating..."
                android:textColor="@color/white"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

</RelativeLayout>