<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    >

    <androidx.core.widget.NestedScrollView
        android:id="@+id/nestedScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        >

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="@dimen/_6sdp"
            >

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cl_client_detail"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/list_bacground"
                android:orientation="vertical"
                android:visibility="gone"
                app:layout_constraintTop_toTopOf="parent"
                >

                <TextView
                    android:id="@+id/tvClientDetail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/white"
                    android:ellipsize="end"
                    android:padding="@dimen/padding_medium"
                    android:singleLine="true"
                    android:text="@string/text_label_client_Detail"
                    android:textAppearance="?android:attr/textAppearanceLarge"
                    android:textSize="@dimen/_14sdp"
                    app:layout_constraintTop_toTopOf="parent"
                    />

                <View
                    android:id="@+id/divider_client_detail"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_1sdp"
                    android:background="@color/calendar_gray"
                    app:layout_constraintTop_toBottomOf="@+id/tvClientDetail"
                    />

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/white"
                    android:padding="@dimen/_5sdp"
                    android:visibility="gone"
                    app:layout_constraintTop_toBottomOf="@+id/divider_client_detail"
                    tools:visibility="visible"
                    >

                    <TextView
                        android:id="@+id/text_label_client_code"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:padding="@dimen/_3sdp"
                        android:text="@string/text_label_client_code"
                        android:textColor="@color/tv_color"
                        android:textSize="@dimen/txt_size"
                        app:layout_constraintEnd_toStartOf="@+id/guideline1"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        />

                    <TextView
                        android:id="@+id/tvClientCode"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/margin_small"
                        android:padding="@dimen/_3sdp"
                        android:text=""
                        android:textColor="@color/light_black"
                        android:textSize="@dimen/txt_size"
                        app:layout_constraintBaseline_toBaselineOf="@+id/text_label_client_code"
                        app:layout_constraintStart_toEndOf="@+id/guideline1"
                        app:layout_constraintTop_toTopOf="parent"
                        tools:text="data"
                        />

                    <TextView
                        android:id="@+id/text_label_client_name"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:padding="@dimen/_3sdp"
                        android:text="@string/text_label_client_name"
                        android:textColor="@color/tv_color"
                        android:textSize="@dimen/txt_size"
                        app:layout_constraintEnd_toStartOf="@+id/guideline1"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/text_label_client_code"
                        />

                    <TextView
                        android:id="@+id/tvClientName"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/margin_small"
                        android:padding="@dimen/_3sdp"
                        android:text=""
                        android:textColor="@color/light_black"
                        android:textSize="@dimen/txt_size"
                        app:layout_constraintBaseline_toBaselineOf="@+id/text_label_client_name"
                        app:layout_constraintStart_toEndOf="@+id/guideline1"
                        tools:text="data"
                        />

                    <TextView
                        android:id="@+id/text_label_client_address"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:padding="@dimen/_3sdp"
                        android:text="@string/text_label_client_address"
                        android:textColor="@color/tv_color"
                        android:textSize="@dimen/txt_size"
                        app:layout_constraintEnd_toStartOf="@+id/guideline1"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/text_label_client_name"
                        />

                    <TextView
                        android:id="@+id/tvClientAddress"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/margin_small"
                        android:padding="@dimen/_3sdp"
                        android:text=""
                        android:textColor="@color/light_black"
                        android:textSize="@dimen/txt_size"
                        app:layout_constraintBaseline_toBaselineOf="@+id/text_label_client_address"
                        app:layout_constraintStart_toEndOf="@+id/guideline1"
                        tools:text="data"
                        />

                    <TextView
                        android:id="@+id/text_label_channel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:padding="@dimen/_3sdp"
                        android:text="@string/text_label_channel"
                        android:textColor="@color/tv_color"
                        android:textSize="@dimen/txt_size"
                        app:layout_constraintEnd_toStartOf="@+id/guideline1"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/text_label_client_address"
                        />

                    <TextView
                        android:id="@+id/tvChannel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/margin_small"
                        android:padding="@dimen/_3sdp"
                        android:text=""
                        android:textColor="@color/light_black"
                        android:textSize="@dimen/txt_size"
                        app:layout_constraintBaseline_toBaselineOf="@+id/text_label_channel"
                        app:layout_constraintStart_toEndOf="@+id/guideline1"
                        tools:text="data"
                        />

                    <TextView
                        android:id="@+id/text_label_default_bank"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:padding="@dimen/_3sdp"
                        android:text="@string/text_label_default_bank"
                        android:textColor="@color/tv_color"
                        android:textSize="@dimen/txt_size"
                        app:layout_constraintEnd_toStartOf="@+id/guideline1"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/text_label_channel"
                        />

                    <TextView
                        android:id="@+id/tvDefaultBank"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/margin_small"
                        android:padding="@dimen/_3sdp"
                        android:text=""
                        android:textColor="@color/light_black"
                        android:textSize="@dimen/txt_size"
                        app:layout_constraintBaseline_toBaselineOf="@+id/text_label_default_bank"
                        app:layout_constraintStart_toEndOf="@+id/guideline1"
                        tools:text="data"
                        />

                    <TextView
                        android:id="@+id/text_label_pan_card"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:padding="@dimen/_3sdp"
                        android:text="@string/text_label_pan_card"
                        android:textColor="@color/tv_color"
                        android:textSize="@dimen/txt_size"
                        app:layout_constraintEnd_toStartOf="@+id/guideline1"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/text_label_default_bank"
                        />

                    <TextView
                        android:id="@+id/tvPanCard"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/margin_small"
                        android:padding="@dimen/_3sdp"
                        android:text=""
                        android:textColor="@color/light_black"
                        android:textSize="@dimen/txt_size"
                        app:layout_constraintBaseline_toBaselineOf="@+id/text_label_pan_card"
                        app:layout_constraintStart_toEndOf="@+id/guideline1"
                        tools:text="data"
                        />

                    <TextView
                        android:id="@+id/text_label_account_type"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:padding="@dimen/_3sdp"
                        android:text="@string/text_label_account_type"
                        android:textColor="@color/tv_color"
                        android:textSize="@dimen/txt_size"
                        app:layout_constraintEnd_toStartOf="@+id/guideline1"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/text_label_pan_card"
                        />

                    <TextView
                        android:id="@+id/tvAccountType"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/margin_small"
                        android:padding="@dimen/_3sdp"
                        android:text=""
                        android:textColor="@color/light_black"
                        android:textSize="@dimen/txt_size"
                        app:layout_constraintBaseline_toBaselineOf="@+id/text_label_account_type"
                        app:layout_constraintStart_toEndOf="@+id/guideline1"
                        tools:text="data"
                        />

                    <TextView
                        android:id="@+id/text_label_UCID"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:padding="@dimen/_3sdp"
                        android:text="@string/text_label_UCID"
                        android:textColor="@color/tv_color"
                        android:textSize="@dimen/txt_size"
                        app:layout_constraintEnd_toStartOf="@+id/guideline1"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/text_label_account_type"
                        />

                    <TextView
                        android:id="@+id/tvUCID"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/margin_small"
                        android:padding="@dimen/_3sdp"
                        android:text=""
                        android:textColor="@color/light_black"
                        android:textSize="@dimen/txt_size"
                        app:layout_constraintBaseline_toBaselineOf="@+id/text_label_UCID"
                        app:layout_constraintStart_toEndOf="@+id/guideline1"
                        tools:text="data"
                        />

                    <TextView
                        android:id="@+id/text_label_family_UCID"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:padding="@dimen/_3sdp"
                        android:text="@string/text_label_family_UCID"
                        android:textColor="@color/tv_color"
                        android:textSize="@dimen/txt_size"
                        app:layout_constraintEnd_toStartOf="@+id/guideline1"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/text_label_UCID"
                        />

                    <TextView
                        android:id="@+id/tvFamilyUCID"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/margin_small"
                        android:padding="@dimen/_3sdp"
                        android:text=""
                        android:textColor="@color/light_black"
                        android:textSize="@dimen/txt_size"
                        app:layout_constraintBaseline_toBaselineOf="@+id/text_label_family_UCID"
                        app:layout_constraintStart_toEndOf="@+id/guideline1"
                        tools:text="data"
                        />

                    <TextView
                        android:id="@+id/text_label_branch_code"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:padding="@dimen/_3sdp"
                        android:text="@string/text_label_branch_code"
                        android:textColor="@color/tv_color"
                        android:textSize="@dimen/txt_size"
                        app:layout_constraintEnd_toStartOf="@+id/guideline1"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/text_label_family_UCID"
                        />

                    <TextView
                        android:id="@+id/tvBranchCode"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/margin_small"
                        android:padding="@dimen/_3sdp"
                        android:text=""
                        android:textColor="@color/light_black"
                        android:textSize="@dimen/txt_size"
                        app:layout_constraintBaseline_toBaselineOf="@+id/text_label_branch_code"
                        app:layout_constraintStart_toEndOf="@+id/guideline1"
                        tools:text="data"
                        />

                    <TextView
                        android:id="@+id/text_label_advisory_type"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:padding="@dimen/_3sdp"
                        android:text="@string/text_label_advisory_type"
                        android:textColor="@color/tv_color"
                        android:textSize="@dimen/txt_size"
                        app:layout_constraintEnd_toStartOf="@+id/guideline1"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/text_label_branch_code"
                        />

                    <TextView
                        android:id="@+id/tvAdvisoryType"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/margin_small"
                        android:padding="@dimen/_3sdp"
                        android:text=""
                        android:textColor="@color/light_black"
                        android:textSize="@dimen/txt_size"
                        app:layout_constraintBaseline_toBaselineOf="@+id/text_label_advisory_type"
                        app:layout_constraintStart_toEndOf="@+id/guideline1"
                        tools:text="data"
                        />

                    <TextView
                        android:id="@+id/text_label_account_number"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:padding="@dimen/_3sdp"
                        android:text="@string/text_label_account_number"
                        android:textColor="@color/tv_color"
                        android:textSize="@dimen/txt_size"
                        app:layout_constraintEnd_toStartOf="@+id/guideline1"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/text_label_advisory_type"
                        />

                    <TextView
                        android:id="@+id/tvAccountNumber"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/margin_small"
                        android:padding="@dimen/_3sdp"
                        android:text=""
                        android:textColor="@color/light_black"
                        android:textSize="@dimen/txt_size"
                        app:layout_constraintBaseline_toBaselineOf="@+id/text_label_account_number"
                        app:layout_constraintStart_toEndOf="@+id/guideline1"
                        tools:text="data"
                        />

                    <TextView
                        android:id="@+id/text_label_aadhar_card"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:padding="@dimen/_3sdp"
                        android:text="@string/text_label_aadhar_card"
                        android:textColor="@color/tv_color"
                        android:textSize="@dimen/txt_size"
                        app:layout_constraintEnd_toStartOf="@+id/guideline1"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/text_label_account_number"
                        />

                    <TextView
                        android:id="@+id/tvAadharCard"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/margin_small"
                        android:padding="@dimen/_3sdp"
                        android:text=""
                        android:textColor="@color/light_black"
                        android:textSize="@dimen/txt_size"
                        app:layout_constraintBaseline_toBaselineOf="@+id/text_label_aadhar_card"
                        app:layout_constraintStart_toEndOf="@+id/guideline1"
                        tools:text="data"
                        />

                    <TextView
                        android:id="@+id/text_label_profile"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:background="@drawable/lead_creation_txt_border_select"
                        android:padding="@dimen/_3sdp"
                        android:text="@string/text_label_profile"
                        android:textColor="@color/tv_color"
                        android:textSize="@dimen/txt_size"
                        app:layout_constraintEnd_toStartOf="@+id/guideline1"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/text_label_aadhar_card"
                        />

                    <TextView
                        android:id="@+id/tvProfile"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/margin_small"
                        android:background="@drawable/lead_creation_txt_border_select"
                        android:padding="@dimen/_3sdp"
                        android:text=""
                        android:textColor="@color/light_black"
                        android:textSize="@dimen/txt_size"
                        app:layout_constraintBaseline_toBaselineOf="@+id/text_label_profile"
                        app:layout_constraintStart_toEndOf="@+id/guideline1"
                        tools:text="data"
                        />


                    <androidx.constraintlayout.widget.Guideline
                        android:id="@+id/guideline1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        app:layout_constraintGuide_percent="0.4"
                        />


                </androidx.constraintlayout.widget.ConstraintLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>


            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cl_lead_detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_6sdp"
                android:background="@color/list_background"
                app:layout_constraintTop_toBottomOf="@+id/cl_client_detail"
                >

                <TextView
                    android:id="@+id/tvLeadDetail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/white"
                    android:ellipsize="end"
                    android:padding="@dimen/padding_medium"
                    android:singleLine="true"
                    android:text="@string/text_label_lead_detail"
                    android:textAppearance="?android:attr/textAppearanceLarge"
                    android:textSize="@dimen/_14sdp"
                    app:layout_constraintTop_toTopOf="parent"
                    />

                <View
                    android:id="@+id/divider_lead_detail"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_1sdp"
                    android:background="@color/calendar_gray"
                    app:layout_constraintTop_toBottomOf="@+id/tvLeadDetail"
                    />

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/llLeadDetail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/white"
                    android:orientation="vertical"
                    android:padding="@dimen/_5sdp"
                    android:visibility="visible"
                    app:layout_constraintTop_toBottomOf="@+id/divider_lead_detail"
                    >

                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:padding="@dimen/_3sdp"
                        android:src="@drawable/ic_edit"
                        app:layout_constraintEnd_toStartOf="@+id/tvEditLeadDetail"
                        app:layout_constraintTop_toTopOf="parent"
                        tools:ignore="ContentDescription"
                        />

                    <TextView
                        android:id="@+id/tvEditLeadDetail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:padding="@dimen/_3sdp"
                        android:text="@string/text_label_lead_edit"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/ilLeadID"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_3sdp"
                        app:hintTextAppearance="@style/InputLayout"
                        app:layout_constraintTop_toBottomOf="@+id/tvEditLeadDetail"
                        >

                        <androidx.appcompat.widget.AppCompatEditText
                            android:id="@+id/etLeadID"
                            style="@style/CRMEdittextLeadSelector"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:enabled="false"
                            android:hint="@string/hint_text_lead_id"
                            android:maxLines="1"
                            android:singleLine="true"
                            android:textCursorDrawable="@null"
                            />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/ilLeadCategory"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_3sdp"
                        app:hintTextAppearance="@style/InputLayout"
                        app:layout_constraintTop_toBottomOf="@+id/ilLeadID"
                        >

                        <androidx.appcompat.widget.AppCompatEditText
                            android:id="@+id/etLeadCategory"
                            style="@style/CRMEdittextLeadSelector"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:enabled="false"
                            android:hint="@string/hint_text_lead_category"
                            android:maxLines="1"
                            android:singleLine="true"
                            android:textCursorDrawable="@null"
                            />
                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        android:id="@+id/text_label_profession"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/text_label_profession"
                        android:textColor="@color/text_color_personal"
                        android:textSize="@dimen/_11sdp"
                        app:layout_constraintTop_toBottomOf="@+id/ilLeadCategory"
                        />

                    <Spinner
                        android:id="@+id/spProfession"
                        style="@style/CRMSpinnerSelector_leadView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_3sdp"
                        android:entries="@array/Select"
                        app:layout_constraintTop_toBottomOf="@+id/text_label_profession"
                        />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/ilLeadName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_3sdp"
                        app:hintTextAppearance="@style/InputLayout"
                        app:layout_constraintTop_toBottomOf="@+id/spProfession"
                        >

                        <androidx.appcompat.widget.AppCompatEditText
                            android:id="@+id/etLeadName"
                            style="@style/CRMEdittextLeadSelector"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:digits="ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789"
                            android:enabled="false"
                            android:hint="@string/hint_text_lead_name"
                            android:inputType="textNoSuggestions"
                            android:maxLines="1"
                            android:singleLine="true"
                            android:textCursorDrawable="@null"
                            />
                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        android:id="@+id/tvNameError"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@null"
                        android:enabled="false"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:textColor="@color/error_red"
                        android:textSize="@dimen/_10sdp"
                        android:visibility="gone"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/ilLeadName"
                        tools:text="error"
                        tools:visibility="visible"
                        />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/ilDob"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_3sdp"
                        app:hintTextAppearance="@style/InputLayout"
                        app:layout_constraintTop_toBottomOf="@+id/tvNameError"
                        >


                        <org.droidparts.widget.ClearableEditText
                            android:id="@+id/etDob"
                            style="@style/CRMEdittextLeadSelector"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:drawableEnd="@drawable/ic_close_text"
                            android:enabled="false"
                            android:focusable="false"
                            android:hint="@string/hint_text_dob"
                            android:inputType="date"
                            android:maxLines="1"
                            android:singleLine="true"
                            android:textCursorDrawable="@null"
                            />
                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        android:id="@+id/tvAnniversaryError"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@null"
                        android:enabled="false"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:textColor="@color/error_red"
                        android:textSize="@dimen/_10sdp"
                        android:visibility="gone"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/ilDob"
                        tools:text="error"
                        tools:visibility="visible"
                        />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/ilAnniversary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_3sdp"
                        app:hintTextAppearance="@style/InputLayout"
                        app:layout_constraintTop_toBottomOf="@+id/tvAnniversaryError"
                        >


                        <org.droidparts.widget.ClearableEditText
                            android:id="@+id/etAnniversary"
                            style="@style/CRMEdittextLeadSelector"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:drawableEnd="@drawable/ic_close_text"
                            android:enabled="false"
                            android:focusable="false"
                            android:hint="@string/hint_text_anniversary"
                            android:inputType="date"
                            android:maxLines="1"
                            android:singleLine="true"
                            android:textCursorDrawable="@null"
