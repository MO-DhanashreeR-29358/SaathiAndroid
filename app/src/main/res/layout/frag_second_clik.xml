<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dashbord_background">

    <com.mosl.tabapp.common.CustomViewPager
        android:id="@+id/pagerLeadsDays"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@+id/view"
        android:background="@color/white" />

    <View
        android:id="@+id/view"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_above="@+id/indicatorLeadsDays"
        android:background="@color/calendar_gray" />

    <com.viewpagerindicator.TabPageIndicator
        android:id="@+id/indicatorLeadsDays"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="@color/white" />
</RelativeLayout>