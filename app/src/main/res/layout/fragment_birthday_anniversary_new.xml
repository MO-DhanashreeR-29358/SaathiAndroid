<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:segmentedgroup="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    >

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/grid_background"
        >

        <Spinner
            android:id="@+id/spProfile"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/_3sdp"
            app:layout_constraintEnd_toStartOf="@+id/spEventType"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            />

        <Spinner
            android:id="@+id/spEventType"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/_3sdp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/spProfile"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBaseline_toBaselineOf="@+id/spProfile"
            />

        <info.hoang8f.android.segmented.SegmentedGroup
            android:id="@+id/segmentedGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/margin_medium"
            android:background="@color/white"
            android:orientation="horizontal"
            app:layout_constraintTop_toBottomOf="@+id/spProfile"
            app:sc_checked_text_color="@color/white"
            segmentedgroup:sc_border_width="@dimen/_1sdp"
            segmentedgroup:sc_corner_radius="@dimen/_3sdp"
            segmentedgroup:sc_tint_color="@color/secondaryBackground"
            >

            <RadioButton
                android:id="@+id/btnBelated"
                style="@style/RadioButton"
                android:layout_width="0dp"
                android:layout_height="@dimen/_30sdp"
                android:layout_weight="1"
                android:text="@string/text_button_label_belated"
                />

            <RadioButton
                android:id="@+id/btnToday"
                style="@style/RadioButton"
                android:layout_width="0dp"
                android:layout_height="@dimen/_30sdp"
                android:layout_weight="1"
                android:checked="true"
                android:text="@string/text_button_label_today"
                />

            <RadioButton
                android:id="@+id/btnUpcomming"
                style="@style/RadioButton"
                android:layout_width="0dp"
                android:layout_height="@dimen/_30sdp"
                android:layout_weight="1"
                android:text="@string/text_button_label_upcoming"
                />
        </info.hoang8f.android.segmented.SegmentedGroup>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvBirthdayAnniversary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_3sdp"
            android:layout_marginTop="@dimen/_10sdp"
            android:layout_marginEnd="@dimen/_3sdp"
            android:layout_marginBottom="@dimen/_3sdp"
            app:layout_constraintBottom_toTopOf="@+id/frameLayout"
            app:layout_constraintTop_toBottomOf="@+id/segmentedGroup"
            tools:listitem="@layout/item_recycler_birthday_anniversary"
            />

        <FrameLayout
            android:id="@+id/frameLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            >

            <View
                android:id="@+id/view"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_6sdp"
                android:layout_gravity="bottom"
                android:background="@color/white"
                />

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/ivEmailAll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="top|center_horizontal"
                app:srcCompat="@drawable/ic_email_all_clients"
                />
        </FrameLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>


</layout>
