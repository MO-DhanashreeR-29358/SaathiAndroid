<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:fab="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorWhite"
    >


    <ScrollView
        android:id="@id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingBottom="@dimen/_20sdp"
        android:layout_below="@+id/spPeriod">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            >


            <!-- Target vs Achievement-->
            <LinearLayout
                android:id="@+id/llTarget"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="visible"
                >

                <RelativeLayout
                    android:id="@+id/rlTargetAchievementADV"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_35sdp"
                    android:background="@color/titleBarBackground"
                    >

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerInParent="true"
                        android:layout_toStartOf="@+id/txtTarget"
                        app:srcCompat="@drawable/ic_target_achievement"
                        />

                    <TextView
                        android:id="@+id/txtTarget"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerInParent="true"
                        android:layout_marginStart="@dimen/_5sdp"
                        android:singleLine="true"
                        android:text="Target Vs Achievement"
                        android:textColor="@color/alternateTextColor"
                        android:textSize="@dimen/appTitleTextSize"
                        android:textStyle="bold"
                        />

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/ivTargetAchievementADV"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:layout_marginEnd="@dimen/_3sdp"
                        android:src="@drawable/minus"
                        />

                </RelativeLayout>


                <LinearLayout
                    android:id="@+id/llTargetAchievementADV"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    >

                </LinearLayout>

            </LinearLayout>


            <LinearLayout
                android:id="@+id/llRunrateforAdvisor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_5sdp"
                android:orientation="vertical"
                android:visibility="visible"
                >

                <RelativeLayout
                    android:id="@+id/rlRunrateForAdvisorADV"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_35sdp"
                    android:background="@color/titleBarBackground"
                    >

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerInParent="true"
                        android:layout_toStartOf="@+id/tvRunrateforAdvisorHeader"
                        app:srcCompat="@drawable/ic_incentive_performance"
                        />

                    <TextView
                        android:id="@+id/tvRunrateforAdvisorHeader"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerInParent="true"
                        android:layout_marginStart="@dimen/_5sdp"
                        android:singleLine="true"
                        android:text="Runrate for Advisor"
                        android:textColor="@color/alternateTextColor"
                        android:textSize="@dimen/appTitleTextSize"
                        android:textStyle="bold"
                        />

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/ivRunrateforAdvisorHeader"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:layout_marginEnd="@dimen/_3sdp"
                        android:src="@drawable/minus"/>
                </RelativeLayout>

                <LinearLayout
                    android:id="@+id/llRunrateforAdvisorADV"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    >

                </LinearLayout>

            </LinearLayout>


        </LinearLayout>
    </ScrollView>

    <RelativeLayout
        android:id="@+id/llMain"
        android:layout_width="match_parent"
        android:layout_height="match_parent">



        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/ivActionableInsights"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_marginStart="@dimen/_12sdp"
            android:visibility="visible"
            app:srcCompat="@drawable/ic_actionable"
            />

</RelativeLayout>

    <com.getbase.floatingactionbutton.FloatingActionsMenu
        android:id="@+id/floatingActionsMenu"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        fab:fab_addButtonColorNormal="#f54d41"
        fab:fab_addButtonColorPressed="@color/white_pressed"
        fab:fab_addButtonPlusIconColor="@color/white"
        fab:fab_labelStyle="@style/menu_labels_style"
        >

        <com.getbase.floatingactionbutton.FloatingActionButton
            android:id="@+id/leadcreation"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:fab_icon="@drawable/ic_create_lead"
            fab:fab_colorNormal="#ffffff"
            fab:fab_colorPressed="#ffffff"
            fab:fab_size="mini"
            fab:fab_title="Create Lead"
            />
    </com.getbase.floatingactionbutton.FloatingActionsMenu>


</RelativeLayout>