<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

  <androidx.constraintlayout.widget.ConstraintLayout
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:layout_margin="15dp"
      android:background="@color/titleBarBackground">

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ivCreateMeeting"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="10dp"
        android:paddingBottom="10dp"
        android:paddingTop="10dp"
        android:visibility="visible"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ic_new_create_meeting_white" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ivSetAppointment"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="10dp"
        android:paddingBottom="10dp"
        android:paddingTop="10dp"
        android:visibility="visible"
        app:layout_constraintStart_toEndOf="@id/ivCreateMeeting"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ic_new_set_app_white" />


    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ivCall"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="10dp"
        android:paddingBottom="10dp"
        android:paddingTop="10dp"
        app:layout_constraintStart_toEndOf="@id/ivSetAppointment"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ic_call_white" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ivSms"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="10dp"
        android:paddingBottom="10dp"
        android:paddingTop="10dp"
        app:layout_constraintStart_toEndOf="@id/ivCall"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ic_new_sms" />


  </androidx.constraintlayout.widget.ConstraintLayout>

  <androidx.appcompat.widget.AppCompatImageView
      android:id="@+id/ivClose"
      android:layout_width="@dimen/_30sdp"
      android:layout_height="@dimen/_30sdp"
      android:layout_gravity="end"
      android:layout_marginBottom="@dimen/_minus15sdp"
      app:srcCompat="@drawable/ic_new_closed" />
</FrameLayout>