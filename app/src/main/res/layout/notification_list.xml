<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/linearLayoutOfListItem"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_5sdp"
        android:orientation="horizontal"
        android:paddingBottom="@dimen/_5sdp">

        <View
            android:id="@+id/rowTab"
            android:layout_width="5dp"
            android:layout_height="0dp"
            android:layout_marginEnd="@dimen/_5sdp"
            android:background="@color/yellow_menu"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/dateView"
            android:layout_width="@dimen/_56sdp"
            android:layout_height="@dimen/_56sdp"
            android:layout_marginStart="@dimen/_8sdp"
            android:layout_marginTop="@dimen/_5sdp"
            app:layout_constraintStart_toEndOf="@+id/rowTab"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ic_date" />

        <TextView
            android:id="@+id/dateUpper"
            android:layout_width="@dimen/_56sdp"
            android:layout_height="@dimen/_28sdp"
            android:gravity="center"
            android:singleLine="true"
            android:text=""
            android:textColor="@color/black"
            android:textSize="@dimen/txt_size"
            app:layout_constraintEnd_toEndOf="@+id/dateView"
            app:layout_constraintStart_toStartOf="@+id/dateView"
            app:layout_constraintTop_toTopOf="@+id/dateView" />

        <TextView
            android:id="@+id/dateLower"
            android:layout_width="@dimen/_56sdp"
            android:layout_height="@dimen/_28sdp"
            android:gravity="center"
            android:singleLine="true"
            android:text=""
            android:textColor="@color/black"
            android:textSize="@dimen/txt_size"
            app:layout_constraintBottom_toBottomOf="@+id/dateView"
            app:layout_constraintEnd_toEndOf="@+id/dateView"
            app:layout_constraintStart_toStartOf="@+id/dateView" />

        <TextView
            android:id="@+id/txtMessage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/_10sdp"
            android:layout_marginTop="@dimen/_5sdp"
            android:ellipsize="end"
            android:text=""
            android:textColor="@color/black"
            android:textSize="@dimen/txt_size"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/dateView"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/timestamp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_below="@id/txtMessage"
            android:layout_marginTop="@dimen/_5sdp"
            android:layout_marginEnd="@dimen/_10sdp"
            android:drawableLeft="@drawable/ic_clock"
            android:gravity="end|center_vertical"
            android:text=""
            android:textSize="@dimen/txt_size"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/txtMessage" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>