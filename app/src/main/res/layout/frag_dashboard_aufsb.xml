<?xml version="1.0" encoding="utf-8"?>
<layout>

    <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:id="@+id/lldashboardAufsb"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        >


        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/_10sdp"
            android:text="@string/OPEN_AN_ACCOUNT"
            android:textSize="@dimen/_15sdp"
            android:textStyle="bold"
            />

        <RelativeLayout
            android:id="@+id/rlFreshRegistration"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/_10sdp"
            android:background="@drawable/list_white_background"
            >

            <LinearLayout
                android:id="@+id/linaerLayout1"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_alignParentStart="true"
                android:layout_toStartOf="@+id/linaerLayout"
                android:orientation="vertical"
                android:paddingStart="@dimen/_8sdp"
                android:paddingTop="@dimen/_8sdp"
                android:paddingBottom="@dimen/_8sdp"
                >

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    >

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="@dimen/_24sdp"
                        android:layout_height="@dimen/_24sdp"
                        app:srcCompat="@drawable/ic_fresh_registration"
                        />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_5sdp"
                        android:text="@string/MOSL_MENU_FRESH_REGISTRATION_TXT"
                        android:textColor="@color/black"
                        android:textSize="@dimen/_15sdp"
                        />

                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_8sdp"
                    android:layout_marginEnd="@dimen/_8sdp"
                    android:text="@string/TXT_FRESH_REGISTRATION"
                    android:textColor="@color/grey_text"
                    android:textSize="@dimen/appTitleTextSize"
                    />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/linaerLayout"
                android:layout_width="@dimen/_20sdp"
                android:layout_height="0dp"
                android:layout_alignTop="@+id/linaerLayout1"
                android:layout_alignBottom="@+id/linaerLayout1"
                android:layout_alignParentEnd="true"
                android:background="@drawable/orange_background"
                >

                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="@dimen/_20sdp"
                    android:layout_height="@dimen/_20sdp"
                    android:layout_gravity="center_vertical"
                    android:padding="@dimen/_3sdp"
                    app:srcCompat="@drawable/ic_double_arrow"
                    />
            </LinearLayout>
        </RelativeLayout>


        <RelativeLayout
            android:id="@+id/rlExisting"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/_10sdp"
            android:layout_marginRight="@dimen/_10sdp"
            android:background="@drawable/list_white_background"
            >

            <LinearLayout
                android:id="@+id/linaerLayout2"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_alignParentStart="true"
                android:layout_toStartOf="@+id/linaerLayout3"
                android:orientation="vertical"
                android:paddingStart="@dimen/_8sdp"
                android:paddingTop="@dimen/_8sdp"
                android:paddingBottom="@dimen/_8sdp"
                >

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    >

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="@dimen/_24sdp"
                        android:layout_height="@dimen/_24sdp"
                        app:srcCompat="@drawable/ic_existing_application"
                        />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_5sdp"
                        android:text="@string/MOSL_MENU_EXISTING_APPLICATIONS_TXT"
                        android:textColor="@color/black"
                        android:textSize="@dimen/_15sdp"
                        />

                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_8sdp"
                    android:layout_marginEnd="@dimen/_8sdp"
                    android:text="@string/TXT_EXISTING_APPLICATION"
                    android:textColor="@color/grey_text"
                    android:textSize="@dimen/appTitleTextSize"
                    />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/linaerLayout3"
                android:layout_width="@dimen/_20sdp"
                android:layout_height="0dp"
                android:layout_alignTop="@+id/linaerLayout2"
                android:layout_alignBottom="@+id/linaerLayout2"
                android:layout_alignParentEnd="true"
                android:background="@drawable/orange_background"
                >

                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="@dimen/_20sdp"
                    android:layout_height="@dimen/_20sdp"
                    android:layout_gravity="center_vertical"
                    android:padding="@dimen/_3sdp"
                    app:srcCompat="@drawable/ic_double_arrow"
                    />
            </LinearLayout>
        </RelativeLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_10sdp"
            android:layout_marginTop="@dimen/_20sdp"
            android:text="@string/TXT_QUERY"
            android:textSize="@dimen/appTitleTextSize"
            android:textStyle="bold"
            />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_5sdp"
            android:layout_marginTop="@dimen/_15sdp"
            android:orientation="horizontal"
            >

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="@dimen/_24sdp"
                android:layout_height="@dimen/_24sdp"
                app:srcCompat="@drawable/ic_contact"
                />

            <TextView
                android:id="@+id/txtTelephoneNo1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_10sdp"
                android:text="@string/TXT_AUFSB_TELEPHONE1"
                android:textSize="@dimen/appTitleTextSize"
                />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="5dp"
                android:text="/"
                android:textSize="@dimen/appTitleTextSize"
                />


            <TextView
                android:id="@+id/txtTelephoneNo2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/TXT_AUFSB_TELEPHONE2"
                android:textSize="@dimen/appTitleTextSize"
                />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/llEmail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_5sdp"
            android:layout_marginTop="@dimen/_15sdp"
            android:orientation="horizontal"
            >

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="@dimen/_24sdp"
                android:layout_height="@dimen/_24sdp"
                app:srcCompat="@drawable/ic_email"
                />

            <TextView
                android:id="@+id/tv_email"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_10sdp"
                android:text="@string/TXT_AUFSB_GMAIL"
                android:textSize="@dimen/appTitleTextSize"
                />

        </LinearLayout>
    </LinearLayout>
</layout>