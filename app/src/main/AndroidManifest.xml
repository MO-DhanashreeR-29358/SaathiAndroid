<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.mosl.tabapp">

    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" tools:remove="android:maxSdkVersion" />

    <queries>
        <!-- Camera -->
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
        <!-- Gallery-->
        <intent>
             <action android:name="android.intent.action.GET_CONTENT" />
            <data android:mimeType="image/*" />
        </intent>
    </queries>
    <queries>
        <package android:name="com.mosl.mobile.modao" />
    </queries>

    <queries>
        <package android:name="com.nsdl.egov.sdkEsignAuth" />
    </queries>

    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <application
        android:name=".SaathiAppImpl"
        android:allowBackup="false"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/icon_app_saathi"
        android:label="@string/main_app_name"
        android:largeHeap="true"
        android:requestLegacyExternalStorage="true"
        android:supportsRtl="true"
        android:theme="@style/CRMMOSLTheme"
        android:usesCleartextTraffic="false"
        tools:replace="android:theme">
        <activity android:name=".settings.SettingActivity"></activity>

        <meta-data android:name="google_analytics_default_allow_analytics_storage" android:value="true" />

        <activity
            android:name=".slider.SliderActivity"
            android:clearTaskOnLaunch="true"
            android:configChanges="keyboard|keyboardHidden|orientation|navigation"
            android:screenOrientation="portrait"
            android:theme="@style/CRMMOSLTheme"
            android:windowSoftInputMode="stateHidden"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:host="com.mosl.tabapp"
                    android:scheme="app" />
            </intent-filter>
        </activity>
        <activity
            android:name=".splash.SplashActivity"
            android:clearTaskOnLaunch="true"
            android:configChanges="keyboard|keyboardHidden|orientation|navigation"
            android:screenOrientation="portrait"
            android:theme="@style/CRMMOSLTheme"
            android:windowSoftInputMode="stateHidden" />
        <activity
            android:name=".login.LoginActivity"
            android:configChanges="keyboard|keyboardHidden|orientation|navigation"
            android:screenOrientation="portrait"
            android:theme="@style/CRMMOSLTheme"
            android:windowSoftInputMode="stateHidden|adjustPan" />
        <activity
            android:name=".core.CommonActivity"
            android:screenOrientation="portrait"
            android:theme="@style/CRMMOSLTheme" />
        <activity
            android:name=".branch.BranchActivity"
            android:screenOrientation="portrait"
            android:theme="@style/CRMMOSLTheme" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="@string/file_provider_authority"
            android:exported="false"
            android:grantUriPermissions="true"
            tools:replace="android:authorities">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <activity
            android:name="com.mosl.ekycexpress.login.core.LoginActivity"
            android:configChanges="keyboard|keyboardHidden|orientation|navigation"
            android:screenOrientation="portrait"
            android:theme="@style/EkycTheme"
            android:windowSoftInputMode="stateHidden|adjustPan" />

        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="AIzaSyBMQAiQWGdFOTRPecAwybutD8O7XMdUhiQ" />
        <!--<meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="AIzaSyCBwZ-oxAQ2ww1o7Y9zqpGGQZsGP1FBg3w" />-->

        <activity
            android:name="com.mosl.ekycexpress.core.CommonActivity"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize"
            android:screenOrientation="portrait"
            android:theme="@style/EkycTheme"
            android:windowSoftInputMode="stateHidden"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
            </intent-filter>
        </activity>

        <activity
            android:name="com.mosl.ekycexpress.webview.WebViewActivity"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize"
            android:screenOrientation="portrait"
            android:theme="@style/EkycTheme"
            android:windowSoftInputMode="stateHidden" />
        <activity
            android:name="com.digio.in.esign2sdk.DigioEsignActivity"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize"
            android:screenOrientation="portrait" />

        <service
            android:name=".service.MessageReceiverIntentService"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <service
            android:name=".service.ForegroundService"
            android:enabled="true" />

        <activity
            android:name="com.nsdl.egov.esignaar.NsdlEsignActivity"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="stateAlwaysHidden"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>


        <activity
            android:name="com.squareup.leakcanary.internal.DisplayLeakActivity"
            android:enabled="false"
            android:label="@string/leak_canary_display_activity_label"
            android:process=":leakcanary"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>


    </application>

</manifest>