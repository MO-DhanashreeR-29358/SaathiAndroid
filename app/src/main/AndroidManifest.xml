<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.mosl.tabapp">

    <uses-permission android:name="android.permission.READ_PHONE_STATE"/>
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE"/>
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"/>
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"/>
    <uses-permission android:name="android.permission.CAMERA"/>
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>


    <uses-feature
        android:name="android.hardware.camera"
        android:required="false"/>

    <application
        android:name="com.mosl.tabapp.SaathiAppImpl"
        android:allowBackup="false"
        android:hardwareAccelerated="true"
        android:icon="@drawable/app_icon"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/CRMMOSLTheme">
        <activity
            android:name="com.mosl.tabapp.ui.ImageSliderActivity"
            android:clearTaskOnLaunch="true"
            android:configChanges="keyboard|keyboardHidden|orientation|navigation"
            android:label="@string/app_name"
            android:screenOrientation="portrait"
            android:theme="@style/CRMMOSLTheme"
            android:windowSoftInputMode="stateHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>

                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>

                <data
                    android:host="com.mosl.tabapp"
                    android:scheme="app"/>
            </intent-filter>

            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts"/>
        </activity>
        <activity
            android:name=".splash.SplashActivityNew"
            android:clearTaskOnLaunch="true"
            android:configChanges="keyboard|keyboardHidden|orientation|navigation"
            android:label="@string/app_name"
            android:screenOrientation="portrait"
            android:theme="@style/CRMMOSLTheme"
            android:windowSoftInputMode="stateHidden">
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts"/>
        </activity>
        <activity
            android:name=".login.LoginActivityNew"
            android:configChanges="keyboard|keyboardHidden|orientation|navigation"
            android:label="@string/app_name"
            android:screenOrientation="portrait"
            android:theme="@style/CRMMOSLTheme"
            android:windowSoftInputMode="stateHidden|adjustPan"/>
        <!--<activity
            android:name="com.mosl.tabapp.ui.MOSLCommonActivity"
            android:screenOrientation="portrait"
            android:theme="@style/CRMMOSLTheme"/>-->

        <activity
            android:name=".core.CommonActivity"
            android:screenOrientation="portrait"
            android:theme="@style/CRMMOSLTheme"/>

        <activity
            android:name=".collateral.WebActivity"
            android:configChanges="orientation|keyboardHidden|screenSize"
            android:screenOrientation="portrait"
            android:theme="@style/CRMMOSLTheme"
            android:windowSoftInputMode="stateHidden"/>

        <receiver android:name="com.mosl.tabapp.common.NetworkStateReceiver">
            <intent-filter>
                <action android:name="android.net.conn.CONNECTIVITY_CHANGE"/>
            </intent-filter>
        </receiver>
        <meta-data
            android:name="io.fabric.ApiKey"
            android:value="dda79f66330d41eeba7f4fcf83cfc3d519aaf942"/>
        <!--<meta-data
            android:name="io.fabric.ApiKey"
            android:value="3cc8c76f5c3a4f08cb553d9080f4c4f1cade791c" />-->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.mosl.tabapp.provider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"/>
        </provider>

        <service
            android:name="com.mosl.tabapp.service.MessageReceiverIntentService"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT"/>
            </intent-filter>
        </service>

        <service
            android:name=".service.ForegroundService"
            android:enabled="true"></service>
    </application>
</manifest>