<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginTop="@dimen/_5sdp"
    android:background="@drawable/border_shadow"
    android:orientation="vertical"
    android:padding="@dimen/_5sdp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/_2sdp"
        android:background="@color/secondaryBackground"
        android:gravity="center"
        android:padding="@dimen/_5sdp"
        android:text="Commodity Scheme"
        android:textSize="@dimen/_11sdp"
        android:textStyle="bold" />


    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_margin="@dimen/_2sdp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/llBranchCommodityBankScheme"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <include layout="@layout/layout_branch_commodity_bank_scheme" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/llBACommodityBankScheme"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone">

                <include layout="@layout/layout_ba_commodity_bank_scheme" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>