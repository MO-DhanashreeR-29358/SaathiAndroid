<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    >

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="@dimen/_10sdp"
        >

        <ScrollView
            android:id="@+id/scrollView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            >

            <LinearLayout
                android:id="@+id/llUpi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/border_shadow"
                android:orientation="vertical"
                android:padding="@dimen/_5sdp"
                >

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/_2sdp"
                    android:background="@color/secondaryBackground"
                    android:gravity="center"
                    android:padding="@dimen/_5sdp"
                    android:text="@string/fundtransfer"
                    android:textSize="@dimen/_11sdp"
                    android:textStyle="bold"
                    />


                <TextView
                    android:id="@+id/tvFundTransfered"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/_2sdp"
                    android:gravity="start"
                    android:text="@string/fundtransfered"
                    android:textSize="@dimen/_11sdp"
                    android:textStyle="bold"
                    />

                <LinearLayout
                    android:id="@+id/llFundOption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:orientation="vertical"
                    >

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_5sdp"
                        android:layout_marginTop="@dimen/_15sdp"
                        android:text="@string/pay_using_upi"
                        android:textColor="@color/secondaryBackground"
                        android:textSize="@dimen/_10sdp"
                        />


                    <EditText
                        android:id="@+id/etBankName"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_40sdp"
                        android:layout_marginTop="@dimen/_5sdp"
                        android:hint="@string/bankname"
                        android:maxLines="1"
                        android:singleLine="true"
                        />


                    <EditText
                        android:id="@+id/etAccNo"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_40sdp"
                        android:layout_marginTop="@dimen/_5sdp"
                        android:hint="@string/accountno"
                        android:inputType="number"
                        android:maxLength="18"
                        android:maxLines="1"
                        android:singleLine="true"
                        />

                    <android.support.design.widget.TextInputLayout
                        android:id="@+id/input_layout_VpaNo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        >

                        <EditText
                            android:id="@+id/etVpaNo"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/_40sdp"
                            android:layout_marginTop="@dimen/_5sdp"
                            android:hint="@string/text_hint_vpa"
                            android:inputType="text"
                            android:maxLines="1"
                            android:singleLine="true"
                            />
                    </android.support.design.widget.TextInputLayout>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginTop="@dimen/_5sdp"
                        android:text="@string/funds_to_be_transferred"
                        android:textSize="@dimen/_12sdp"
                        />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/_5sdp"
                        android:layout_marginTop="@dimen/_3sdp"
                        android:orientation="horizontal"
                        >

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text=""
                            />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_15sdp"
                            android:layout_weight=".15"
                            android:text="@string/rupee_symbol"
                            android:textSize="@dimen/_20sdp"
                            />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1.8"
                            android:orientation="vertical"
                            >

                            <android.support.design.widget.TextInputLayout
                                android:id="@+id/input_layout_FundTransferred"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                >

                                <EditText
                                    android:id="@+id/etFundTransferred"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:gravity="center"
                                    android:inputType="number"
                                    android:maxLength="7"
                                    android:maxLines="1"
                                    android:singleLine="true"
                                    android:text=""
                                    android:textSize="@dimen/_18sdp"
                                    />
                            </android.support.design.widget.TextInputLayout>

                            <TextView
                                android:id="@+id/etFundTransferredError"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/_minus5sdp"
                                android:background="@null"
                                android:enabled="false"
                                android:focusable="true"
                                android:focusableInTouchMode="true"
                                android:textColor="@color/upload_red"
                                android:textSize="@dimen/_10sdp"
                                android:visibility="gone"
                                />

                        </LinearLayout>

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text=""
                            />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    >

                    <include
                        layout="@layout/layout_merge_of_mosl_note"
                        android:id="@+id/layout_merge_note"
                        />

                    <LinearLayout
                        android:id="@+id/llPaymentButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@color/light_grey_menu"
                        android:orientation="horizontal"
                        >

                        <RelativeLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:visibility="visible"
                            >

                            <Button
                                android:id="@+id/btnPayment"
                                android:layout_width="match_parent"
                                android:layout_height="@dimen/_35sdp"
                                android:layout_centerHorizontal="true"
                                android:layout_gravity="center_horizontal"
                                android:layout_margin="@dimen/_5sdp"
                                android:background="@drawable/ic_submit_btn"
                                android:text="@string/makepayment"
                                android:textColor="@color/white"
                                android:textSize="@dimen/_11sdp"
                                />

                        </RelativeLayout>

                        <RelativeLayout
                            android:id="@+id/rlSkipPayment"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="0.6"
                            android:visibility="visible"
                            >

                            <Button
                                android:id="@+id/btnSkipPayment"
                                android:layout_width="match_parent"
                                android:layout_height="@dimen/_35sdp"
                                android:layout_gravity="center_horizontal"
                                android:layout_margin="@dimen/_5sdp"
                                android:background="@drawable/list_add_background"
                                android:text="@string/skippayment"
                                android:textColor="@color/dark_blue"
                                android:textSize="@dimen/_11sdp"
                                android:visibility="visible"
                                />

                        </RelativeLayout>
                    </LinearLayout>

                    <Button
                        android:id="@+id/btnNext"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_35sdp"
                        android:layout_gravity="center_horizontal"
                        android:layout_margin="@dimen/_5sdp"
                        android:background="@drawable/ic_submit_btn"
                        android:gravity="center"
                        android:text="@string/next"
                        android:textColor="@color/white"
                        android:textSize="@dimen/_11sdp"
                        android:visibility="gone"
                        />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</RelativeLayout>