<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:id="@+id/linearLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/ivClose"
            android:layout_marginLeft="@dimen/_15sdp"
            android:layout_marginRight="@dimen/_15sdp"
            android:background="@color/white"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/_5sdp"
                android:padding="4dp"
                android:singleLine="true"
                android:text="Forgot Password"
                android:textColor="@color/black"
                android:textSize="@dimen/_15sdp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/etForgotEmailError"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/_10sdp"
                android:layout_marginRight="@dimen/_10sdp"
                android:layout_marginTop="@dimen/_minus5sdp"
                android:background="@null"
                android:enabled="false"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:textColor="@color/upload_red"
                android:textSize="@dimen/_10sdp"
                android:visibility="gone" />

            <EditText
                android:id="@+id/etForgotEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/_10sdp"
                android:background="@drawable/edittext_border"
                android:hint="Enter Email ID"
                android:inputType="textEmailAddress"
                android:padding="15dp"
                android:singleLine="true" />

            <TextView
                android:id="@+id/etForgotMobileNumberError"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/_10sdp"
                android:layout_marginRight="@dimen/_10sdp"
                android:layout_marginTop="@dimen/_minus5sdp"
                android:background="@null"
                android:enabled="false"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:textColor="@color/upload_red"
                android:textSize="@dimen/_10sdp"
                android:visibility="gone" />

            <EditText
                android:id="@+id/etForgotMobileNumber"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/_10sdp"
                android:background="@drawable/edittext_border"
                android:hint="Enter Mobile Number"
                android:inputType="phone"
                android:maxLength="10"
                android:padding="15dp"
                android:singleLine="true" />

            <Button
                android:id="@+id/btnForgotSubmit"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_35sdp"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="20dp"
                android:layout_marginLeft="@dimen/_20sdp"
                android:layout_marginRight="@dimen/_20sdp"
                android:layout_marginTop="10dp"
                android:background="@drawable/ic_submit_btn"
                android:text="Submit"
                android:textColor="@color/white"
                android:textSize="@dimen/_14sdp" />
        </LinearLayout>


        <ImageView
            android:id="@+id/ivClose"
            android:layout_width="@dimen/_30sdp"
            android:layout_height="@dimen/_30sdp"
            android:layout_alignParentRight="true"
            android:layout_marginBottom="@dimen/_minus15sdp"
            android:src="@drawable/ic_closed" />
    </RelativeLayout>
</LinearLayout>