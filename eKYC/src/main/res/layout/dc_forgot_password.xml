<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    >

  <LinearLayout
      android:id="@+id/linearLayout"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_below="@+id/ivClose"
      android:layout_marginLeft="@dimen/_15sdp"
      android:layout_marginRight="@dimen/_15sdp"
      android:background="@color/white"
      android:orientation="vertical"
      >

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/_5sdp"
        android:padding="4dp"
        android:singleLine="true"
        android:text="@string/header_label_forgot_password"
        android:textColor="@color/black"
        android:textSize="@dimen/_15sdp"
        android:textStyle="bold"
        />

    <TextView
        android:id="@+id/etForgotEmailError"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/_10sdp"
        android:layout_marginRight="@dimen/_10sdp"
        android:layout_marginTop="@dimen/_minus5sdp"
        android:background="@null"
        android:enabled="false"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:textColor="@color/upload_red"
        android:textSize="@dimen/_10sdp"
        android:visibility="gone"
        />

    <android.support.v7.widget.AppCompatEditText
        android:id="@+id/etForgotEmail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/_10sdp"
        android:background="@drawable/edittext_border"
        android:hint="@string/hint_label_enter_email_id"
        android:inputType="textEmailAddress"
        android:padding="@dimen/_10sdp"
        android:singleLine="true"
        android:visibility="gone"
        />

    <TextView
        android:id="@+id/etForgotMobileNumberError"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/_10sdp"
        android:layout_marginRight="@dimen/_10sdp"
        android:layout_marginTop="@dimen/_minus5sdp"
        android:background="@null"
        android:enabled="false"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:textColor="@color/upload_red"
        android:textSize="@dimen/_10sdp"
        android:visibility="gone"
        />

    <android.support.v7.widget.AppCompatEditText
        android:id="@+id/etForgotMobileNumber"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/_10sdp"
        android:background="@drawable/edittext_border"
        android:hint="@string/hint_label_enter_mobile_number"
        android:inputType="phone"
        android:maxLength="10"
        android:padding="@dimen/_10sdp"
        android:singleLine="true"
        />

    <TextView
        android:id="@+id/etOTPError"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/_10sdp"
        android:layout_marginRight="@dimen/_10sdp"
        android:layout_marginTop="@dimen/_minus5sdp"
        android:background="@null"
        android:enabled="false"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:textColor="@color/upload_red"
        android:textSize="@dimen/_10sdp"
        android:visibility="gone"
        />

    <android.support.v7.widget.AppCompatEditText
        android:id="@+id/etOTP"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/_10sdp"
        android:background="@drawable/edittext_border"
        android:hint="@string/hint_text_label_enter_otp"
        android:inputType="number"
        android:maxLength="4"
        android:padding="@dimen/_10sdp"
        android:singleLine="true"
        android:visibility="gone"
        />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/_10sdp"
        >

      <android.support.v7.widget.AppCompatButton
          android:id="@+id/btnForgotSubmit"
          android:layout_width="0dp"
          android:layout_height="@dimen/_35sdp"
          android:layout_weight="1"
          android:background="@drawable/button_state_bg"
          android:text="@string/submit"
          android:textColor="@color/white"
          android:textSize="@dimen/_14sdp"
          />

      <android.support.v7.widget.AppCompatButton
          android:id="@+id/btnResendOTP"
          android:layout_width="0dp"
          android:layout_height="@dimen/_35sdp"
          android:layout_marginStart="@dimen/_5sdp"
          android:layout_weight="1"
          android:background="@drawable/button_state_bg"
          android:text="@string/resend_otp"
          android:textColor="@color/white"
          android:textSize="@dimen/_14sdp"
          android:visibility="gone"
          />
    </LinearLayout>
  </LinearLayout>


  <ImageView
      android:id="@+id/ivClose"
      android:layout_width="@dimen/_30sdp"
      android:layout_height="@dimen/_30sdp"
      android:layout_alignParentRight="true"
      android:layout_marginBottom="@dimen/_minus15sdp"
      android:src="@drawable/ic_closed"
      />

  <RelativeLayout
      android:id="@+id/customProgress_forgot_password"
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:background="#AA000000"
      android:visibility="gone"
      >

    <ProgressBar
        android:id="@+id/pBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        style="?android:attr/progressBarStyleLarge"
        />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/pBar"
        android:layout_centerHorizontal="true"
        android:text="@string/text_label_loading"
        android:textColor="@color/white"
        android:textSize="13sp"
        />
  </RelativeLayout>
</RelativeLayout>
