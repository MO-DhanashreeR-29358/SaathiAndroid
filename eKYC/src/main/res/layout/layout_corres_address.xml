<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginTop="@dimen/_5sdp"
    android:background="@drawable/border_shadow"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/_5sdp"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/secondaryBackground"
            android:gravity="center"
            android:padding="@dimen/_5sdp"
            android:text="Address Details (Correspondence Address)"
            android:textSize="@dimen/_11sdp"
            android:textStyle="bold" />


        <!--<TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/_2sdp"
            android:text="Bldg No/Bldg Name"
            android:textSize="@dimen/_11sdp"
            android:textStyle="bold" />-->
      <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/input_layout_bldgNameCorres"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_8sdp">

            <EditText
                android:id="@+id/etBldgNameCorres"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/_2sdp"
                android:hint="@string/bldgnobldgname"
                android:maxLength="50"
                android:maxLines="1"
                android:singleLine="true" />
      </com.google.android.material.textfield.TextInputLayout>

        <!--<TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/_2sdp"
            android:text="Flat No/Road Name"
            android:textSize="@dimen/_11sdp"
            android:textStyle="bold" />-->

      <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/input_layout_flatNoCorres"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_8sdp">

            <EditText
                android:id="@+id/etFlatNoCorres"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/_2sdp"
                android:hint="@string/flatnoroadname"
                android:maxLength="50"
                android:maxLines="1"
                android:singleLine="true" />
      </com.google.android.material.textfield.TextInputLayout>

        <!--<TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/_2sdp"
            android:text="Area /Locality"
            android:textSize="@dimen/_11sdp"
            android:textStyle="bold" />-->
      <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/input_layout_areaCorres"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_8sdp">

            <EditText
                android:id="@+id/etAreaCorres"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/_2sdp"
                android:hint="@string/arealocality"
                android:maxLength="50"
                android:maxLines="1"
                android:singleLine="true" />
      </com.google.android.material.textfield.TextInputLayout>


        <!-- <TextView
             android:layout_width="wrap_content"
             android:layout_height="wrap_content"
             android:layout_margin="@dimen/_2sdp"
             android:text="Address proof"
             android:textSize="@dimen/_11sdp"
             android:textStyle="bold" />-->
      <!--<com.google.android.material.textfield.TextInputLayout
          android:id="@+id/input_layout_addProofCorres"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="@dimen/_8sdp">

          <EditText
              android:id="@+id/etAddProofCorres"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:layout_marginBottom="@dimen/_2sdp"
              android:hint="Address Proof" />
      </com.google.android.material.textfield.TextInputLayout>-->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/_2sdp"
            android:text="@string/addressproof"
            android:textColor="@color/text_color_personal"
            android:textSize="@dimen/_11sdp" />

        <TextView
            android:id="@+id/etCorresAddProofError"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_minus5sdp"
            android:background="@null"
            android:enabled="false"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:textColor="@color/upload_red"
            android:textSize="@dimen/_10sdp"
            android:visibility="gone" />

        <Spinner
            android:id="@+id/spCorresAddProof"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_40sdp"
            android:layout_marginBottom="@dimen/_2sdp" />

        <!--<TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/_2sdp"
            android:text="Pincode"
            android:textSize="@dimen/_11sdp"
            android:textStyle="bold" />-->
      <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/input_layout_pincodeCorres"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_8sdp">

            <EditText
                android:id="@+id/etPincodeCorres"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/_2sdp"
                android:hint="@string/pincode"
                android:inputType="number"
                android:maxLength="6"
                android:maxLines="1"
                android:singleLine="true" />
      </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/etPincodeCorresError"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_minus5sdp"
            android:background="@null"
            android:enabled="false"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:textColor="@color/upload_red"
            android:textSize="@dimen/_10sdp"
            android:visibility="gone" />


        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/_2sdp"
            android:text="@string/state"
            android:textColor="@color/text_color_personal"
            android:textSize="@dimen/_11sdp" />

        <TextView
            android:id="@+id/etCorresStateError"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_minus5sdp"
            android:background="@null"
            android:enabled="false"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:textColor="@color/upload_red"
            android:textSize="@dimen/_10sdp"
            android:visibility="gone" />

        <com.mosl.mobile.ekyc.common.SearchableSpinner
            android:id="@+id/spCorresState"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_40sdp"
            android:layout_marginBottom="@dimen/_2sdp" />

        <EditText
            android:id="@+id/etCorresState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_minus5sdp"
            android:enabled="false"
            android:maxLines="1"
            android:singleLine="true"
            android:visibility="gone" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/_2sdp"
            android:layout_marginTop="@dimen/_5sdp"
            android:text="@string/citytownvillage"
            android:textColor="@color/text_color_personal"
            android:textSize="@dimen/_11sdp" />

        <TextView
            android:id="@+id/etCorresCityError"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_minus5sdp"
            android:background="@null"
            android:enabled="false"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:textColor="@color/upload_red"
            android:textSize="@dimen/_10sdp"
            android:visibility="gone" />

        <com.mosl.mobile.ekyc.common.SearchableSpinner
            android:id="@+id/spCorresCity"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_40sdp"
            android:layout_marginBottom="@dimen/_2sdp" />

        <EditText
            android:id="@+id/etCorresCity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_minus5sdp"
            android:enabled="false"
            android:visibility="gone" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/_5sdp"
            android:text="@string/country"
            android:textColor="@color/text_color_personal"
            android:textSize="@dimen/_11sdp" />

        <TextView
            android:id="@+id/etCorresCountryError"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_minus5sdp"
            android:background="@null"
            android:enabled="false"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:textColor="@color/upload_red"
            android:textSize="@dimen/_10sdp"
            android:visibility="gone" />

        <Spinner
            android:id="@+id/spCorresCountry"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_40sdp"
            android:layout_marginBottom="@dimen/_2sdp"
            android:entries="@array/country" />
    </LinearLayout>


</LinearLayout>