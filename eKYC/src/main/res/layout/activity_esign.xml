<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <RelativeLayout
        android:id="@+id/rlAffix"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvEsignTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/secondaryBackground"
            android:gravity="center"
            android:padding="@dimen/_5sdp"
            android:text=""
            android:textSize="@dimen/_11sdp"
            android:textStyle="bold" />
    </RelativeLayout>

    <Button
        android:id="@+id/btnRetry"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/rlAffix"
        android:layout_margin="@dimen/_5sdp"
        android:text="Retry"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/btnRetry"
        android:orientation="vertical">

        <ScrollView
            android:id="@+id/scrollView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/_10sdp">

                <LinearLayout
                    android:id="@+id/llPreEsign"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_horizontal"
                    android:orientation="horizontal"
                    android:visibility="visible">

                    <!--<ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                    <TextView
                        android:id="@+id/tvPreEsign"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Click here"
                        android:textColor="@drawable/text_color" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=" to download Pre e-sign KYC form"
                        android:textColor="@color/black" />-->

                    <ListView
                        android:id="@+id/pdfListView"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_alignParentLeft="false"
                        android:layout_alignParentTop="false"
                        android:layout_marginBottom="20dp"
                        android:layout_marginTop="10dp"
                        android:divider="@null"
                        android:listSelector="@android:color/transparent"
                        android:transcriptMode="alwaysScroll" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/llEsignConsent"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_below="@+id/llPreEsign"
                    android:layout_marginTop="10dp"
                    android:visibility="gone">

                    <CheckBox
                        android:id="@+id/cbEsignConsent"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:button="@drawable/checkbox"
                        android:checked="true"
                        android:textColor="@color/example_hint"
                        android:textSize="@dimen/_10sdp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_marginLeft="@dimen/_5sdp"
                        android:text="@string/esign_consent"
                        android:textColor="@color/black"
                        android:textSize="@dimen/_10sdp" />


                </LinearLayout>

                <TextView
                    android:id="@+id/tvAuthenticationMode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/llEsignConsent"
                    android:layout_marginTop="@dimen/_5sdp"
                    android:gravity="center"
                    android:text="@string/br_ba_authenticate_msg"
                    android:textColor="@color/grey_text"
                    android:textSize="@dimen/_9sdp"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/llParentOTPBio"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/tvAuthenticationMode"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:orientation="horizontal"
                        android:weightSum="1">

                        <ImageView
                            android:id="@+id/ivOTP"
                            android:layout_width="@dimen/_50sdp"
                            android:layout_height="@dimen/_50sdp"
                            android:background="@drawable/ic_otp_xml"
                            android:gravity="center" />

                        <ImageView
                            android:id="@+id/ivThumb"
                            android:layout_width="@dimen/_50sdp"
                            android:layout_height="@dimen/_50sdp"
                            android:layout_marginLeft="@dimen/_20sdp"
                            android:background="@drawable/ic_thumb_xml"
                            android:gravity="center" />
                        <!--<RadioButton
                            android:id="@+id/rbOTP"
                            android:layout_width="@dimen/_50sdp"
                            android:layout_height="@dimen/_50sdp"
                            android:background="@drawable/ic_otp_xml"
                            android:gravity="center" />

                        <RadioButton
                            android:id="@+id/rbThumb"
                            android:layout_width="@dimen/_50sdp"
                            android:layout_height="@dimen/_50sdp"
                            android:layout_marginLeft="@dimen/_20sdp"
                            android:background="@drawable/ic_thumb_xml" />-->
                    </LinearLayout>


                </LinearLayout>

                <LinearLayout
                    android:id="@+id/llOTPThumbLayout"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_120sdp"
                    android:layout_below="@+id/llParentOTPBio"
                    android:layout_marginTop="@dimen/_30sdp"
                    android:gravity="center_horizontal"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <RelativeLayout
                        android:id="@+id/rlOTP"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">


                        <LinearLayout
                            android:id="@+id/llOTP"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_centerHorizontal="true"
                            android:orientation="vertical">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="@dimen/_5sdp"
                                android:layout_marginTop="@dimen/_7sdp">

                                <ImageView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:src="@drawable/ic_icons_otp" />

                                <EditText
                                    android:id="@+id/etOTP"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:gravity="center"
                                    android:hint="Enter 6-digit OTP number"
                                    android:inputType="number"
                                    android:maxLength="6"
                                    android:maxLines="1"
                                    android:singleLine="true" />

                            </LinearLayout>


                            <!-- <Button
                                 android:id="@+id/btnSignEkyc"
                                 android:layout_width="match_parent"
                                 android:layout_height="wrap_content"
                                 android:layout_centerHorizontal="true"
                                 android:layout_marginTop="@dimen/_7sdp"
                                 android:background="@drawable/ic_submit_btn"
                                 android:text="Sign" />-->
                        </LinearLayout>

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_below="@+id/llOTP"
                            android:layout_marginTop="@dimen/_10sdp">

                            <TextView
                                android:id="@+id/tvOTPHeading"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/otp_heading"
                                android:textColor="@color/grey_text"
                                android:textSize="@dimen/_10sdp" />

                            <TextView
                                android:id="@+id/tvResendOTP"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentRight="true"
                                android:text="@string/resend_otp"
                                android:textColor="@drawable/text_color"
                                android:textSize="@dimen/_10sdp" />

                        </RelativeLayout>
                    </RelativeLayout>


                </LinearLayout>


                <!--<LinearLayout
                    android:id="@+id/llPostEKYC"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/llOTPThumbLayout"
                    android:layout_marginLeft="@dimen/_20sdp"
                    android:layout_marginRight="@dimen/_20sdp"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:gravity="center_horizontal"
                    android:orientation="horizontal"
                    android:visibility="gone">


                    <TextView
                        android:id="@+id/tvPostEKYC"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Click here"
                        android:textColor="@drawable/text_color" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=" to download Post e-sign KYC form"
                        android:textColor="@color/black" />

                </LinearLayout>-->

                <RelativeLayout
                    android:id="@+id/rlClientCode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/llOTPThumbLayout"
                    android:layout_marginTop="@dimen/_15sdp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tvClientCode"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/_10sdp"
                        android:layout_marginRight="@dimen/_20sdp"
                        android:text="Client Code"
                        android:textSize="@dimen/title_11sp"
                        android:textStyle="bold" />


                    <LinearLayout
                        android:id="@+id/llClienCode"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/tvClientCode"
                        android:layout_marginLeft="@dimen/_10sdp"
                        android:layout_marginTop="@dimen/_3sdp">

                        <ImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_4sdp"
                            android:src="@drawable/ic_client_code" />


                        <EditText
                            android:id="@+id/editClienCode"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="@dimen/_2sdp"
                            android:hint="Enter Client code"
                            android:inputType="text"
                            android:maxLength="10"
                            android:maxLines="1"
                            android:singleLine="true"
                            android:text="" />

                    </LinearLayout>

                    <EditText
                        android:id="@+id/editClienCodeError"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/llClienCode"
                        android:layout_marginLeft="@dimen/_20sdp"
                        android:background="@null"
                        android:enabled="false"
                        android:textColor="@color/upload_red"
                        android:textSize="@dimen/_10sdp"
                        android:visibility="gone" />

                </RelativeLayout>

                <TextView
                    android:id="@+id/tvClientCodeNote"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/rlClientCode"
                    android:layout_marginLeft="@dimen/_10sdp"
                    android:layout_marginRight="@dimen/_20sdp"
                    android:layout_marginTop="@dimen/_8sdp"
                    android:text="Choose the desired client code as you are just few minutes away from activating your account. Post activation of the account you can start investing instantly."
                    android:textColor="@color/grey_text"
                    android:textSize="@dimen/_9sdp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/llEmendate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/tvClientCodeNote"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tvEmendateTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_5sdp"
                        android:padding="@dimen/_2sdp"
                        android:textColor="@color/secondaryBackground"
                        android:textSize="@dimen/_10sdp" />

                    <TextView
                        android:id="@+id/tvEmendateDiscription"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_1sdp"
                        android:padding="@dimen/_2sdp"
                        android:text="@string/declaration_for_emandate"
                        android:textColor="@color/black"
                        android:textSize="@dimen/_10sdp" />

                    <TextView
                        android:id="@+id/tvEmendate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/_10sdp"
                        android:padding="@dimen/_2sdp"
                        android:text="@string/click_here"
                        android:textColor="@drawable/contact_text_color"
                        android:textSize="@dimen/_10sdp" />
                </LinearLayout>
            </RelativeLayout>
        </ScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/_7sdp"
            android:background="@color/light_grey_menu">

            <Button
                android:id="@+id/btnSubmit"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_35sdp"
                android:background="@drawable/ic_submit_btn"
                android:text="Submit"
                android:textColor="@color/white"
                android:textSize="@dimen/_14sdp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>
