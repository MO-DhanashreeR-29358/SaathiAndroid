<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="5dp">

    <TextView
        android:id="@+id/txtHeader"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_30sdp"
        android:background="@color/black"
        android:gravity="center"
        android:text="Research &amp; Advice"
        android:textColor="#ffffff"
        android:textSize="@dimen/_18sdp" />

    <LinearLayout
        android:id="@+id/llView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/txtHeader"
        android:layout_marginTop="5dp"
        android:orientation="horizontal">

        <View
            android:layout_width="0dp"
            android:layout_height="@dimen/_1sdp"
            android:layout_gravity="center"
            android:layout_weight=".5"
            android:background="@color/black" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_5sdp"
            android:layout_weight="1.2"
            android:gravity="center"
            android:text="@string/search_reports"
            android:textColor="@color/black"
            android:textSize="@dimen/_15sdp" />

        <View
            android:layout_width="0dp"
            android:layout_height="@dimen/_1sdp"
            android:layout_gravity="center"
            android:layout_weight=".5"
            android:background="@color/black" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/llSearch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/llView"
        android:background="@color/light_grey_menu"
        android:padding="15dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/_25sdp"
            android:layout_toLeftOf="@+id/btnBusinessSummary"
            android:layout_toRightOf="@+id/btnMenu"
            android:background="@color/white"
            android:orientation="horizontal">

            <!--<com.mosl.mobile.ekyc.ui.DelayAutoCompleteTextView
                android:id="@+id/searchText"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:autoText="false"
                android:background="@android:color/transparent"
                android:hint="search"
                android:inputType="textAutoComplete|textAutoCorrect"
                android:paddingLeft="5dp" />-->
            <EditText
                android:id="@+id/searchText"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:autoText="false"
                android:background="@android:color/transparent"
                android:hint="Search for report name"
                android:paddingLeft="5dp" />

            <ProgressBar
                android:id="@+id/pbLoadingIndicator"
                style="?android:attr/progressBarStyleSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginRight="5dp"
                android:visibility="gone" />

            <ImageButton
                android:layout_width="@dimen/_25sdp"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:layout_marginLeft="5dp"
                android:background="@android:color/black"
                android:padding="2dp"
                android:src="@drawable/search" />


        </LinearLayout>
    </LinearLayout>

    <ListView
        android:id="@+id/lvResearch"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/llSearch"
        android:layout_marginTop="5dp"
        tools:listitem="@layout/item_list_collateral_research" />

    <FrameLayout
        android:id="@+id/activityFrameLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/llSearch" />

    <include layout="@layout/layout_custom_progress" />
</RelativeLayout>