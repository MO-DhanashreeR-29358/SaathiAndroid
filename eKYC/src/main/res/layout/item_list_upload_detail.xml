<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="@dimen/_5sdp"
        android:layout_marginLeft="@dimen/_5sdp"
        android:layout_marginRight="@dimen/_5sdp"
        android:background="@drawable/list_background"
        android:orientation="vertical"
        android:paddingBottom="@dimen/_5sdp">

        <RelativeLayout
            android:id="@+id/rlDocument"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/_10sdp"
            android:layout_marginRight="@dimen/_10sdp"
            android:layout_marginTop="@dimen/_10sdp">

            <RelativeLayout
                android:id="@+id/rlDocumentSub"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_35sdp"
                android:layout_toLeftOf="@+id/llRowAction"
                android:background="@drawable/list_add_background">

                <com.mosl.mobile.ekyc.common.RoundedImageView
                    android:id="@+id/ivDocument"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:src="@drawable/ic_upload_4" />

                <TextView
                    android:id="@+id/tvDocument"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginLeft="@dimen/_10sdp"
                    android:layout_toRightOf="@+id/ivDocument"
                    android:text="PAN"
                    android:textColor="@color/dark_blue"
                    android:textSize="@dimen/_14sdp" />

            </RelativeLayout>

            <LinearLayout
                android:id="@+id/llRowAction"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/_35sdp"
                android:layout_alignParentEnd="true"
                android:layout_alignParentRight="true">
                <!--    <ImageView
                        android:id="@+id/ivDocumentStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_5sdp"
                        android:layout_marginLeft="@dimen/_5sdp"
                        android:layout_marginRight="@dimen/_10sdp"
                        android:src="@drawable/ic_gray" />-->
                <ImageView
                    android:id="@+id/imDeleteRow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginLeft="@dimen/_5sdp"
                    android:src="@drawable/ic_trash"
                    android:visibility="gone" />
            </LinearLayout>


            <ImageView
                android:id="@+id/imDownload"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/rlDocumentSub"
                android:layout_marginRight="@dimen/_5sdp"
                android:layout_marginTop="@dimen/_5sdp"
                android:padding="@dimen/_3sdp"
                android:src="@drawable/ic_view1"
                android:visibility="visible" />
            <!--<ImageView
                android:id="@+id/imDelete"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/rlDocumentSub"
                android:layout_toRightOf="@id/imDownload"
                android:layout_marginRight="@dimen/_5sdp"
                android:layout_marginTop="@dimen/_5sdp"
                android:src="@drawable/ic_trash"
                android:visibility="visible"/>-->

            <TextView
                android:id="@+id/tvDocumentMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/rlDocumentSub"
                android:layout_marginTop="@dimen/_8sdp"
                android:layout_toRightOf="@id/imDownload"
                android:text="Cancelled cheque with your name printed on it"
                android:textColor="@color/market_text"
                android:textSize="@dimen/_12sdp" />
        </RelativeLayout>
    </LinearLayout>
</LinearLayout>