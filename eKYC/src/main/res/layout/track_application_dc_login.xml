<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/track_application_background"
    >

  <RelativeLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_centerVertical="true"
      android:layout_marginLeft="@dimen/_15sdp"
      android:layout_marginRight="@dimen/_15sdp"
      android:background="@drawable/dc_resume_app_background"
      android:padding="15dp"
      >


    <LinearLayout
        android:id="@+id/llPanNo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        >

      <androidx.appcompat.widget.AppCompatButton
          android:id="@+id/etPanNo"
          android:layout_width="match_parent"
          android:layout_height="@dimen/_40sdp"
          android:background="@drawable/edittext_border"
          android:hint="@string/hint_text_label_pan_no"
          android:inputType="textEmailAddress"
          android:maxLength="10"
          android:paddingEnd="@dimen/_3sdp"
          android:paddingStart="@dimen/_3sdp"
          android:singleLine="true"
          />

    </LinearLayout>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/etPanNoError"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/llPanNo"
        android:background="@null"
        android:enabled="false"
        android:paddingEnd="@dimen/_3sdp"
        android:paddingStart="@dimen/_3sdp"
        android:textColor="@color/upload_red"
        android:textSize="@dimen/_10sdp"
        android:visibility="gone"
        />

    <LinearLayout
        android:id="@+id/llOTP"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/llPanNo"
        android:layout_marginTop="@dimen/_15sdp"
        android:orientation="horizontal"
        android:visibility="gone"
        >

      <androidx.appcompat.widget.AppCompatButton
          android:id="@+id/etOTP"
          android:layout_width="match_parent"
          android:layout_height="@dimen/_40sdp"
          android:background="@drawable/edittext_border"
          android:hint="@string/hint_text_label_enter_otp"
          android:inputType="number"
          android:maxLength="4"
          android:paddingEnd="@dimen/_3sdp"
          android:paddingStart="@dimen/_3sdp"
          android:singleLine="true"
          />

    </LinearLayout>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/etOTPError"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/llOTP"
        android:background="@null"
        android:enabled="false"
        android:paddingEnd="@dimen/_3sdp"
        android:paddingStart="@dimen/_3sdp"
        android:textColor="@color/upload_red"
        android:textSize="@dimen/_10sdp"
        android:visibility="gone"
        />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/llOTP"
        android:layout_marginTop="@dimen/_15sdp"
        >

      <androidx.appcompat.widget.AppCompatButton
          android:id="@+id/btnVerify"
          android:layout_width="0dp"
          android:layout_height="@dimen/_35sdp"
          android:layout_weight="1"
          android:background="@drawable/button_state_bg"
          android:text="@string/button_label_verify"
          android:textColor="@color/white"
          android:textSize="@dimen/_14sdp"
          />

      <androidx.appcompat.widget.AppCompatButton
          android:id="@+id/btnResendOTP"
          android:layout_width="0dp"
          android:layout_height="@dimen/_35sdp"
          android:layout_marginStart="@dimen/_5sdp"
          android:layout_weight="1"
          android:background="@drawable/button_state_bg"
          android:text="@string/resend_otp"
          android:textColor="@color/white"
          android:textSize="@dimen/_14sdp"
          android:visibility="gone"
          />
    </LinearLayout>
  </RelativeLayout>

  <RelativeLayout
      android:id="@+id/customProgress"
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:background="#AA000000"
      android:visibility="gone"
      >

    <ProgressBar
        android:id="@+id/pBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        style="?android:attr/progressBarStyleLarge"
        />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/pBar"
        android:layout_centerHorizontal="true"
        android:text="@string/text_label_loading"
        android:textColor="@color/white"
        android:textSize="13sp"
        />
  </RelativeLayout>
</RelativeLayout>
