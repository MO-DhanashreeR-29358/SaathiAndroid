<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#edebec">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/_228sdp"
        android:layout_alignParentTop="true"
        android:layout_centerHorizontal="true"
        android:background="@color/secondaryBackground" />

    <FrameLayout
        android:id="@+id/flMain"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_120sdp"
        android:layout_marginTop="@dimen/_170sdp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginLeft="25dp"
            android:layout_marginRight="25dp"
            android:background="@drawable/dc_resume_app_background"
            android:orientation="vertical"
            android:padding="15dp">


            <LinearLayout
                android:id="@+id/llPanNo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/etPanNo"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_40sdp"
                    android:background="@drawable/edittext_border"
                    android:hint="Enter Your PAN Number"
                    android:inputType="textEmailAddress"
                    android:maxLength="10"
                    android:paddingLeft="@dimen/_5sdp"
                    android:singleLine="true"
                    android:text="" />

            </LinearLayout>

            <EditText
                android:id="@+id/etPanNoError"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/llPanNo"
                android:background="@null"
                android:enabled="false"
                android:paddingLeft="@dimen/_5sdp"
                android:textColor="@color/upload_red"
                android:textSize="@dimen/_10sdp"
                android:visibility="gone" />
        </RelativeLayout>

        <ImageView
            android:id="@+id/ivSubmit"
            android:layout_width="@dimen/_40sdp"
            android:layout_height="@dimen/_40sdp"
            android:layout_gravity="center|end"
            android:layout_marginRight="@dimen/_12sdp"
            android:src="@drawable/ic_login_red" />
    </FrameLayout>
</RelativeLayout>