<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginTop="@dimen/_5sdp"
    android:background="@drawable/border_shadow"
    android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/_2sdp"
        android:background="@color/secondaryBackground"
        android:gravity="center"
        android:padding="@dimen/_5sdp"
        android:text="Address Details (Permanent Address)"
        android:textSize="@dimen/_11sdp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/_5sdp"
        android:orientation="vertical">


        <CheckBox
            android:id="@+id/cbSameAsCorrespondence"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_40sdp"
            android:button="@drawable/checkbox"
            android:text="  Same as Correspondence" />

        <!-- <TextView
             android:layout_width="match_parent"
             android:layout_height="wrap_content"
             android:layout_margin="@dimen/_2sdp"
             android:text="Bldg No/Bldg Name"
             android:textSize="@dimen/_11sdp"
             android:textStyle="bold" />-->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/input_layout_bldgNamePerm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <EditText
                android:id="@+id/etBldgNamePerm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/_2sdp"
                android:hint="@string/bldgnobldgname"
                android:maxLength="30"
                android:maxLines="1"
                android:singleLine="true" />
        </com.google.android.material.textfield.TextInputLayout>

        <!--<TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/_2sdp"
            android:text="Flat No/Road Name"
            android:textSize="@dimen/_11sdp"
            android:textStyle="bold" />-->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/input_layout_flatNamePerm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <EditText
                android:id="@+id/etFlatNamePerm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/_2sdp"
                android:hint="@string/flatnoroadname"
                android:maxLength="30"
                android:maxLines="1"
                android:singleLine="true" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- <TextView
             android:layout_width="wrap_content"
             android:layout_height="wrap_content"
             android:layout_margin="@dimen/_2sdp"
             android:text="Area /Locality"
             android:textSize="@dimen/_11sdp"
             android:textStyle="bold" />-->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/input_layout_areaPerm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <EditText
                android:id="@+id/etAreaPerm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/_2sdp"
                android:hint="@string/arealocality"
                android:maxLength="30"
                android:maxLines="1"
                android:singleLine="true" />

        </com.google.android.material.textfield.TextInputLayout>
        <!--<TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/_2sdp"
            android:text="Address proof"
            android:textSize="@dimen/_11sdp"
            android:textStyle="bold" />-->
        <!--<com.google.android.material.textfield.TextInputLayout
            android:id="@+id/input_layout_addProofPerm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <EditText
                android:id="@+id/etAddProofPerm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/_2sdp"
                android:hint="Address Proof" />

        </com.google.android.material.textfield.TextInputLayout>-->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/_2sdp"
            android:text="@string/addressproof"
            android:textColor="@color/text_color_personal"
            android:textSize="@dimen/_11sdp" />

        <TextView
            android:id="@+id/etPermAddProofError"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_minus5sdp"
            android:background="@null"
            android:enabled="false"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:textColor="@color/upload_red"
            android:textSize="@dimen/_10sdp"
            android:visibility="gone" />

        <Spinner
            android:id="@+id/spPermAddProof"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_40sdp"
            android:layout_marginBottom="@dimen/_2sdp" />
        <!--<TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/_2sdp"
            android:text="Pincode"
            android:textSize="@dimen/_11sdp"
            android:textStyle="bold" />-->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/input_layout_pincodePerm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <EditText
                android:id="@+id/etPincodePerm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/_2sdp"
                android:hint="@string/pincode"
                android:inputType="number"
                android:maxLength="6"
                android:maxLines="1"
                android:singleLine="true" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/etPincodePermError"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_minus5sdp"
            android:background="@null"
            android:enabled="false"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:textColor="@color/upload_red"
            android:textSize="@dimen/_10sdp"
            android:visibility="gone" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/_2sdp"
            android:text="@string/state"
            android:textColor="@color/text_color_personal"
            android:textSize="@dimen/_11sdp" />

        <TextView
            android:id="@+id/etPermStateError"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_minus5sdp"
            android:background="@null"
            android:enabled="false"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:textColor="@color/upload_red"
            android:textSize="@dimen/_10sdp"
            android:visibility="gone" />

        <com.mosl.mobile.ekyc.common.SearchableSpinner
            android:id="@+id/spPermState"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_40sdp"
            android:layout_marginBottom="@dimen/_2sdp" />

        <EditText
            android:id="@+id/etPermState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/_minus5sdp"
            android:layout_marginTop="@dimen/_minus5sdp"
            android:enabled="false"
            android:visibility="gone" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/_2sdp"
            android:layout_marginTop="@dimen/_5sdp"
            android:text="@string/citytownvillage"
            android:textColor="@color/text_color_personal"
            android:textSize="@dimen/_11sdp" />

        <TextView
            android:id="@+id/etPermCityError"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_minus5sdp"
            android:background="@null"
            android:enabled="false"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:textColor="@color/upload_red"
            android:textSize="@dimen/_10sdp"
            android:visibility="gone" />

        <com.mosl.mobile.ekyc.common.SearchableSpinner
            android:id="@+id/spPermCity"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_40sdp"
            android:layout_marginBottom="@dimen/_2sdp" />

        <EditText
            android:id="@+id/etPermCity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/_minus5sdp"
            android:layout_marginTop="@dimen/_minus5sdp"
            android:enabled="false"
            android:visibility="gone" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/_2sdp"
            android:layout_marginTop="@dimen/_5sdp"
            android:text="@string/country"
            android:textColor="@color/text_color_personal"
            android:textSize="@dimen/_11sdp" />

        <TextView
            android:id="@+id/etPermCountryError"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_minus5sdp"
            android:background="@null"
            android:enabled="false"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:textColor="@color/upload_red"
            android:textSize="@dimen/_10sdp"
            android:visibility="gone" />

        <Spinner
            android:id="@+id/spPermCountry"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_40sdp"
            android:layout_marginBottom="@dimen/_2sdp"
            android:entries="@array/country" />
    </LinearLayout>
</LinearLayout>