<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/buttonBackground"
    android:orientation="vertical">

    <TextView
        android:id="@+id/tvNomineeJointTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/_2sdp"
        android:background="@color/secondaryBackground"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:gravity="center"
        android:padding="@dimen/_5sdp"
        android:text=""
        android:textSize="@dimen/_11sdp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/tvNomineeJointTitle"
        android:orientation="vertical">

        <ScrollView
            android:id="@+id/scrollview"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_margin="@dimen/_2sdp"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/_5sdp"
                    android:background="@drawable/border_shadow"
                    android:orientation="vertical"
                    android:padding="5dp">

                    <LinearLayout
                        android:id="@+id/llNomineeQuestion"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="@dimen/_2sdp"
                        android:orientation="vertical"
                        android:weightSum="1">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/nominee_form_detail"
                            android:textColor="@color/text_color_personal"
                            android:textSize="@dimen/title_11sp" />

                        <ToggleButton
                            android:id="@+id/toggleNominee"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@android:color/transparent"
                            android:button="@drawable/toggle_selector"
                            android:textOff=""
                            android:textOn="" />
                        <!--<RadioGroup
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerInParent="true"
                            android:orientation="horizontal">

                            <CheckBox
                                android:id="@+id/cbNomineeNo"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_centerHorizontal="true"
                                android:layout_centerVertical="true"
                                android:layout_marginRight="@dimen/_2sdp"
                                android:layout_weight="1"
                                android:text="No"
                                android:textSize="@dimen/_10sdp" />

                            <CheckBox
                                android:id="@+id/cbNomineeYes"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_centerHorizontal="true"
                                android:layout_centerVertical="true"
                                android:layout_weight="1"
                                android:checked="false"
                                android:text="Yes"
                                android:textSize="@dimen/_10sdp" />
                        </RadioGroup>-->
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/llNomineeDetail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="@dimen/_5sdp"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <include layout="@layout/layout_nominee_details" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/llJointHolderQuestion"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_margin="@dimen/_2sdp"
                            android:orientation="vertical"
                            android:weightSum="1">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/demat_account_detail"
                                android:textColor="@color/text_color_personal"
                                android:textSize="@dimen/title_11sp" />

                            <ToggleButton
                                android:id="@+id/toggleJointHolder"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@android:color/transparent"
                                android:button="@drawable/toggle_selector"
                                android:textOff=""
                                android:textOn="" />
                            <!--<RadioGroup
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_centerInParent="true"
                                android:orientation="horizontal">

                                <CheckBox
                                    android:id="@+id/cbIndividual"
                                    android:layout_width="0dp"
                                    android:layout_height="match_parent"
                                    android:layout_centerHorizontal="true"
                                    android:layout_centerVertical="true"
                                    android:layout_marginRight="@dimen/_2sdp"
                                    android:layout_weight="1"
                                    android:text="Individual"
                                    android:textSize="@dimen/_10sdp" />

                                <CheckBox
                                    android:id="@+id/cbJoint"
                                    android:layout_width="0dp"
                                    android:layout_height="match_parent"
                                    android:layout_centerHorizontal="true"
                                    android:layout_centerVertical="true"
                                    android:layout_weight="1"
                                    android:checked="false"
                                    android:text="Joint"
                                    android:textSize="@dimen/_10sdp" />
                            </RadioGroup>-->
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/llNumberOfJointHolder"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:visibility="gone">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_margin="@dimen/_2sdp"
                                android:text="Number of Joint Holder"
                                android:textColor="@color/text_color_personal"
                                android:textSize="@dimen/_11sdp" />

                            <TextView
                                android:id="@+id/etNumberOfJointHolderError"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/_minus5sdp"
                                android:background="@null"
                                android:enabled="false"
                                android:focusable="true"
                                android:focusableInTouchMode="true"
                                android:textColor="@color/upload_red"
                                android:textSize="@dimen/_10sdp"
                                android:visibility="gone" />

                            <Spinner
                                android:id="@+id/spNumberOfJointHolder"
                                android:layout_width="match_parent"
                                android:layout_height="@dimen/_40sdp"
                                android:layout_marginBottom="@dimen/_2sdp"
                                android:entries="@array/numberOfJointHolder" />
                        </LinearLayout>
                    </LinearLayout>

                    <!--        <Button
                                android:id="@+id/btnSubmit"
                                android:layout_width="match_parent"
                                android:layout_height="@dimen/_35sdp"
                                android:layout_centerHorizontal="true"
                                android:layout_margin="@dimen/_10sdp"
                                android:layout_weight="1"
                                android:background="@drawable/button_state_bg"
                                android:gravity="center"
                                android:text="Submit"
                                android:textColor="@color/white"
                                android:textSize="@dimen/_14sdp"
                                android:textStyle="bold" />-->
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/llJointHolderDetail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/_5sdp"
                    android:orientation="vertical"
                    android:padding="2dp"
                    android:visibility="gone">

                    <include layout="@layout/layout_joint_holder_detail" />
                </LinearLayout>

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_5sdp"
                    android:background="@color/light_grey_menu"
                    android:padding="@dimen/_5sdp"
                    android:visibility="visible"
                    >

                    <include
                        layout="@layout/layout_merge_of_mosl_note"
                        android:id="@+id/layout_merge_note"
                        />

                    <Button
                        android:id="@+id/btnSaveJointNominee"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_35sdp"
                        android:layout_below="@+id/layout_merge_note"
                        android:layout_centerHorizontal="true"
                        android:layout_margin="@dimen/_10sdp"
                        android:background="@drawable/ic_submit_btn"
                        android:text="Next"
                        android:textColor="@color/white"
                        />
                </RelativeLayout>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</RelativeLayout>