<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">


        <TextView
            android:id="@+id/tvBranchCodeTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/_2sdp"
            android:text="Equity Branch Code"
            android:textColor="@color/text_color_personal"
            android:textSize="@dimen/_11sdp" />

        <TextView
            android:id="@+id/etEqBranchCodeError"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_minus5sdp"
            android:background="@null"
            android:enabled="false"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:textColor="@color/upload_red"
            android:textSize="@dimen/_10sdp"
            android:visibility="gone" />

        <Spinner
            android:id="@+id/spEqBranchCode"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_40sdp"
            android:layout_marginBottom="@dimen/_2sdp" />

        <TextView
            android:id="@+id/tvSubrokerCodeTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/_2sdp"
            android:text="Equity Sub-broker Code"
            android:textColor="@color/text_color_personal"
            android:textSize="@dimen/_11sdp" />

        <TextView
            android:id="@+id/etEqSubrokerCodeError"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_minus5sdp"
            android:background="@null"
            android:enabled="false"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:textColor="@color/upload_red"
            android:textSize="@dimen/_10sdp"
            android:visibility="gone" />

        <Spinner
            android:id="@+id/spEqSubBroker"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_40sdp"
            android:layout_marginBottom="@dimen/_2sdp" />

        <TextView
            android:id="@+id/tvTraderCodeTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/_2sdp"
            android:text="Equity Trader Code"
            android:textColor="@color/text_color_personal"
            android:textSize="@dimen/_11sdp" />

        <TextView
            android:id="@+id/etEqTraderCodeError"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_minus5sdp"
            android:background="@null"
            android:enabled="false"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:textColor="@color/upload_red"
            android:textSize="@dimen/_10sdp"
            android:visibility="gone" />

        <Spinner
            android:id="@+id/spEqTrader"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_40sdp"
            android:layout_marginBottom="@dimen/_2sdp" />

        <TextView
            android:id="@+id/tvAreaTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/_2sdp"
            android:text="Equity Area"
            android:textColor="@color/text_color_personal"
            android:textSize="@dimen/_11sdp" />

        <TextView
            android:id="@+id/etEqAreaError"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_minus5sdp"
            android:background="@null"
            android:enabled="false"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:textColor="@color/upload_red"
            android:textSize="@dimen/_10sdp"
            android:visibility="gone" />

        <Spinner
            android:id="@+id/spEqArea"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_40sdp"
            android:layout_marginBottom="@dimen/_2sdp" />

        <TextView
            android:id="@+id/tvRegionTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/_2sdp"
            android:text="Equity Region"
            android:textColor="@color/text_color_personal"
            android:textSize="@dimen/_11sdp" />

        <TextView
            android:id="@+id/etEqRegionError"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_minus5sdp"
            android:background="@null"
            android:enabled="false"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:textColor="@color/upload_red"
            android:textSize="@dimen/_10sdp"
            android:visibility="gone" />


        <Spinner
            android:id="@+id/spEqRegion"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_40sdp"
            android:layout_marginBottom="@dimen/_2sdp" />
    </LinearLayout>
</LinearLayout>