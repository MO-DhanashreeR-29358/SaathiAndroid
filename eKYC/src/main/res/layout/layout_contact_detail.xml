<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginTop="@dimen/_5sdp"
    android:background="@drawable/border_shadow"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/_5sdp"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/_2sdp"
            android:background="@color/secondaryBackground"
            android:gravity="center"
            android:padding="@dimen/_5sdp"
            android:text="Contact Details"
            android:textSize="@dimen/_11sdp"
            android:textStyle="bold" />


        <!--<TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/_2sdp"
            android:text="Mobile Number"
            android:textSize="@dimen/_11sdp"
            android:textStyle="bold" />-->
      <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/input_layout_mobile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_8sdp">

            <EditText
                android:id="@+id/etMobile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/_2sdp"
                android:hint="@string/mobilenumber"
                android:inputType="number"
                android:maxLength="10"
                android:maxLines="1"
                android:singleLine="true" />
      </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/etMobileError"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_minus5sdp"
            android:background="@null"
            android:enabled="false"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:textColor="@color/upload_red"
            android:textSize="@dimen/_10sdp"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tvMobile"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="click here"
                android:textColor="@drawable/contact_text_color"
                android:textSize="@dimen/_10sdp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" to modify this mobile number for MOSL* future communication"
                android:textSize="@dimen/_10sdp" />
        </LinearLayout>
        <!--
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/_2sdp"
                    android:text="Email ID"
                    android:textSize="@dimen/_11sdp"
                    android:textStyle="bold" />-->
      <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/input_layout_email"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_5sdp">

            <EditText
                android:id="@+id/etEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/_2sdp"
                android:hint="@string/emailid"
                android:inputType="textEmailAddress"
                android:maxLines="1"
                android:singleLine="true" />
      </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/etEmailError"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_minus5sdp"
            android:background="@null"
            android:enabled="false"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:textColor="@color/upload_red"
            android:textSize="@dimen/_10sdp"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tvEmail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="click here"
                android:textColor="@drawable/contact_text_color"
                android:textSize="@dimen/_10sdp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" to modify this email id for MOSL* future communication"
                android:textSize="@dimen/_10sdp" />
        </LinearLayout>

        <RelativeLayout
            android:id="@+id/rlFamilyDeclaration"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <CheckBox
                    android:id="@+id/cbFamilyDeclaration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:button="@drawable/checkbox"
                    android:checked="true"
                    android:enabled="false"
                    android:textColor="@color/example_hint"
                    android:textSize="@dimen/_13sdp" />

                <TextView
                    android:id="@+id/tvFamilyDeclaration"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="Provide Family Declaration "
                    android:textColor="@drawable/text_color"
                    android:textSize="@dimen/_10sdp" />
            </LinearLayout>

            <ImageView
                android:id="@+id/ivViewFamilyDeclaration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentRight="true"
                android:layout_marginRight="@dimen/_10sdp"
                android:src="@drawable/viewfamilyrelation" />
        </RelativeLayout>

        <!--  <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_margin="@dimen/_2sdp"
              android:text="Telephone (Res.)"
              android:textSize="@dimen/_11sdp"
              android:textStyle="bold" />-->

        <LinearLayout
            android:id="@+id/llContactDetail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

              <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/input_layout_std"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_5sdp"
                    android:layout_weight="1">

                    <EditText
                        android:id="@+id/etSTDNo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/_2sdp"
                        android:hint="@string/std"
                        android:inputType="number"
                        android:maxLength="5"
                        android:maxLines="1"
                        android:singleLine="true" />
              </com.google.android.material.textfield.TextInputLayout>

              <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/input_layout_telNo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_5sdp"
                    android:layout_weight="3">

                    <EditText
                        android:id="@+id/etTelNo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/_2sdp"
                        android:hint="@string/telephone"
                        android:inputType="number"
                        android:maxLength="8"
                        android:maxLines="1"
                        android:singleLine="true" />
              </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/etSTDTelError"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_minus5sdp"
                android:background="@null"
                android:enabled="false"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:textColor="@color/upload_red"
                android:textSize="@dimen/_10sdp"
                android:visibility="gone" />

          <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/inputLayoutAltTelNo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_5sdp">

                <EditText
                    android:id="@+id/etAltTelNo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/_2sdp"
                    android:hint="@string/alternatemobileno"
                    android:inputType="phone"
                    android:maxLength="10"
                    android:maxLines="1" />
          </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:id="@+id/etAltMobileError"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_minus5sdp"
                android:background="@null"
                android:enabled="false"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:textColor="@color/upload_red"
                android:textSize="@dimen/_10sdp"
                android:visibility="gone" />

          <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/inputLayoutAltEmailID"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_5sdp">

                <EditText
                    android:id="@+id/etAltEmailID"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/_2sdp"
                    android:hint="@string/alternateemailid"
                    android:inputType="textEmailAddress"
                    android:maxLines="1" />
          </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:id="@+id/etAltEmailError"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_minus5sdp"
                android:background="@null"
                android:enabled="false"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:textColor="@color/upload_red"
                android:textSize="@dimen/_10sdp"
                android:visibility="gone" />

            <!--<TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/_2sdp"
                android:text="Facebook Id"
                android:textSize="@dimen/_11sdp"
                android:textStyle="bold" />-->
          <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/input_layout_fbId"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_5sdp">

                <EditText
                    android:id="@+id/etFbId"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/_2sdp"
                    android:hint="@string/facebookid"
                    android:inputType="text"
                    android:maxLines="1"
                    android:singleLine="true" />
          </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:id="@+id/etFbIdError"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_minus5sdp"
                android:background="@null"
                android:enabled="false"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:textColor="@color/upload_red"
                android:textSize="@dimen/_10sdp"
                android:visibility="gone" />

            <!--<TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/_2sdp"
                android:text="Twitter Id"
                android:textSize="@dimen/_11sdp"
                android:textStyle="bold" />-->

          <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/input_layout_twitterId"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_5sdp">

                <EditText
                    android:id="@+id/etTwitterId"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/_2sdp"
                    android:hint="@string/twitterid"
                    android:inputType="text"
                    android:maxLines="1"
                    android:singleLine="true" />
          </com.google.android.material.textfield.TextInputLayout>

            <!--<TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/_2sdp"
                android:text="Linkedin ID"
                android:textSize="@dimen/_11sdp"
                android:textStyle="bold" />-->

          <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/input_layout_linkedinID"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_5sdp">

                <EditText
                    android:id="@+id/etLinkedinID"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/_2sdp"
                    android:hint="@string/linkedinid"
                    android:inputType="text"
                    android:maxLines="1"
                    android:singleLine="true" />
          </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:id="@+id/etLinkedinIDError"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/_5sdp"
                android:layout_marginTop="@dimen/_minus5sdp"
                android:background="@null"
                android:enabled="false"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:textColor="@color/upload_red"
                android:textSize="@dimen/_10sdp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>