        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/_40sdp"
            android:layout_weight="1"
            android:orientation="vertical">

            <EditText
                android:id="@+id/etClientCode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                android:layout_marginBottom="10dp"
                android:background="@drawable/login_edittext_border"
                android:drawableLeft="@drawable/login_user"
                android:drawablePadding="5dp"
                android:hint="User"
                android:padding="@dimen/_10sdp"
                android:singleLine="true" />

            <EditText
                android:id="@+id/etClientPass"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                android:layout_marginBottom="10dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/login_edittext_border"
                android:drawableLeft="@drawable/login_paswrd"
                android:drawablePadding="10dp"
                android:ems="10"
                android:hint="Password"
                android:padding="@dimen/_10sdp"
                android:password="true"
                android:singleLine="true" />


            <Button
                android:id="@+id/btnLogin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/etClientPass"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="10dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/login" />
        </LinearLayout>
    </LinearLayout>


    <include layout="@layout/layout_custom_progress" />

</RelativeLayout>