<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/buttonBackground">

    <TextView
        android:id="@+id/tvBankDetailTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/_2sdp"
        android:background="@color/secondaryBackground"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:gravity="center"
        android:padding="@dimen/_5sdp"
        android:text=""
        android:textSize="@dimen/_11sdp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/llFundTransfer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <fragment
            android:id="@+id/fragFundTransfer"
            android:name="com.mosl.mobile.ekyc.bankdetail.FundTransferFragment"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            tools:layout="@layout/activity_fund_transfer" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/llBankDetailForm"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/tvBankDetailTitle"
        android:orientation="vertical"
        android:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="@dimen/_2sdp"
            android:orientation="vertical">

            <ScrollView
                android:id="@+id/svBankForm"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_margin="@dimen/_2sdp"
                android:layout_weight="1">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/llEquityBankDetail"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:visibility="gone">

                        <include layout="@layout/layout_equity_bank_detail" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/llCommodityBankDetail"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:visibility="gone">

                        <include layout="@layout/layout_commodity_bank_detail" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/llMFBankDetail"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:visibility="gone">

                        <include layout="@layout/layout_mf_bank_detail" />

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/llEquityBankScheme"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:visibility="gone">

                        <include layout="@layout/layout_equity_bank_scheme" />
                    </LinearLayout>


                    <LinearLayout
                        android:id="@+id/llCommodityBankScheme"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:visibility="gone">

                        <include layout="@layout/layout_commodity_bank_scheme" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/llFundTransferNote"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginTop="@dimen/_10sdp"
                        android:padding="@dimen/_5sdp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/bank_detail_note"
                            android:textColor="@color/black"
                            android:textSize="@dimen/_10sdp" />
                    </LinearLayout>

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_5sdp"
                        android:background="@color/light_grey_menu"
                        android:padding="@dimen/_5sdp"
                        android:visibility="visible"
                        >

                        <include
                            layout="@layout/layout_merge_of_mosl_note"
                            android:id="@+id/layout_merge_note"
                            />

                        <Button
                            android:id="@+id/btnBankAndSchemeUpdate"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/_35sdp"
                            android:layout_below="@+id/layout_merge_note"
                            android:layout_centerHorizontal="true"
                            android:layout_margin="@dimen/_10sdp"
                            android:background="@drawable/ic_submit_btn"
                            android:text="@string/next"
                            android:textColor="@color/white"
                            />
                    </RelativeLayout>
                </LinearLayout>
            </ScrollView>

        </LinearLayout>
    </LinearLayout>
</RelativeLayout>

