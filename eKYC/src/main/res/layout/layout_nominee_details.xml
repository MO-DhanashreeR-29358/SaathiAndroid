<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:id="@+id/scrollview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/border_shadow"
                android:orientation="vertical"
                android:padding="5dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/_2sdp"
                    android:background="@color/secondaryBackground"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:gravity="center"
                    android:padding="@dimen/_5sdp"
                    android:text="Nominee Details"
                    android:textSize="@dimen/_11sdp"
                    android:textStyle="bold" />


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical">

                    <!--<Spinner
                        android:id="@+id/spNomineeTitle"
                        android:layout_width="@dimen/_60sdp"
                        android:layout_height="@dimen/_35sdp"
                        android:layout_marginBottom="@dimen/_2sdp"
                        android:entries="@array/title" />-->

                  <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/inputLayoutNomineeFirstName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_6sdp">

                        <EditText
                            android:id="@+id/etNomineeFirstName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="First Name"
                            android:maxLines="1"
                            android:singleLine="true" />
                  </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        android:id="@+id/etNomineeFirstNameError"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_minus5sdp"
                        android:background="@null"
                        android:enabled="false"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:textColor="@color/upload_red"
                        android:textSize="@dimen/_10sdp"
                        android:visibility="gone" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_8sdp"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                      <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/inputLayoutNomineeMiddleName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <EditText
                                android:id="@+id/etNomineeMiddleName"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="Middle Name"
                                android:maxLines="1"
                                android:singleLine="true" />
                      </com.google.android.material.textfield.TextInputLayout>

                        <TextView
                            android:id="@+id/etNomineeMiddleNameError"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_minus5sdp"
                            android:background="@null"
                            android:enabled="false"
                            android:focusable="true"
                            android:focusableInTouchMode="true"
                            android:textColor="@color/upload_red"
                            android:textSize="@dimen/_10sdp"
                            android:visibility="gone" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                      <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/inputLayoutNomineeLastName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <EditText
                                android:id="@+id/etNomineeLastName"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="Last Name"
                                android:maxLines="1"
                                android:singleLine="true" />
                      </com.google.android.material.textfield.TextInputLayout>

                        <TextView
                            android:id="@+id/etNomineeLastNameError"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_minus5sdp"
                            android:background="@null"
                            android:enabled="false"
                            android:focusable="true"
                            android:focusableInTouchMode="true"
                            android:textColor="@color/upload_red"
                            android:textSize="@dimen/_10sdp"
                            android:visibility="gone" />
                    </LinearLayout>
                </LinearLayout>

              <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/inputLayoutNomineePAN"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_8sdp">

                    <EditText
                        android:id="@+id/etNomineePAN"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Permanent Account Number (PAN)"
                        android:inputType="text"
                        android:maxLength="10"
                        android:maxLines="1"
                        android:singleLine="true" />
              </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:id="@+id/etNomineePANError"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_minus5sdp"
                    android:background="@null"
                    android:enabled="false"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:textColor="@color/upload_red"
                    android:textSize="@dimen/_10sdp"
                    android:visibility="gone" />


              <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/inputLayoutNomineeAadhaar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_8sdp">

                    <EditText
                        android:id="@+id/etNomineeAadhar"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Unique Identification Number(UID) / Aadhaar"
                        android:inputType="number"
                        android:maxLength="12"
                        android:maxLines="1"
                        android:singleLine="true" />
              </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:id="@+id/tvNomineeAadharError"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_minus5sdp"
                    android:background="@null"
                    android:enabled="false"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:textColor="@color/upload_red"
                    android:textSize="@dimen/_10sdp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/etNomineeDOBRequestFocus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_minus5sdp"
                    android:background="@null"
                    android:enabled="false"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:textColor="@color/upload_red"
                    android:textSize="@dimen/_1sdp" />

              <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/inputLayoutNomineeDob"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_8sdp">

                    <EditText
                        android:id="@+id/etNomineeDOB"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:focusable="false"
                        android:hint="@string/dob"
                        android:inputType="date"
                        android:maxLines="1"
                        android:singleLine="true" />
              </com.google.android.material.textfield.TextInputLayout>

                <CheckBox
                    android:id="@+id/cbNomineeSameAsPrimaryCorrespondence"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_40sdp"
                    android:button="@drawable/checkbox"
                    android:text=" Same as primary applicants correspondence address" />

              <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/inputLayoutNomineeBldgNameCorres"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_8sdp">

                    <EditText
                        android:id="@+id/etNomineeBldgNameCorres"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/_2sdp"
                        android:hint="Bldg No/Bldg Name"
                        android:maxLength="50"
                        android:maxLines="1"
                        android:singleLine="true" />
              </com.google.android.material.textfield.TextInputLayout>

              <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/inputLayoutNomineeFlatNoCorres"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_8sdp">

                    <EditText
                        android:id="@+id/etNomineeFlatNoCorres"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/_2sdp"
                        android:hint="Flat No/Road Name"
                        android:maxLength="50"
                        android:maxLines="1"
                        android:singleLine="true" />
              </com.google.android.material.textfield.TextInputLayout>

              <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/inputLayoutNomineeAreaCorres"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_8sdp">

                    <EditText
                        android:id="@+id/etNomineeAreaCorres"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/_2sdp"
                        android:hint="Area /Locality"
                        android:maxLength="50"
                        android:maxLines="1"
                        android:singleLine="true" />
              </com.google.android.material.textfield.TextInputLayout>


              <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/inputLayoutNomineePincodeCorres"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_8sdp">

                    <EditText
                        android:id="@+id/etNomineePincodeCorres"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/_2sdp"
                        android:hint="Pincode"
                        android:inputType="number"
                        android:maxLength="6"
                        android:maxLines="1"
                        android:singleLine="true" />
              </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:id="@+id/etNomineePincodeCorresError"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_minus5sdp"
                    android:background="@null"
                    android:enabled="false"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:textColor="@color/upload_red"
                    android:textSize="@dimen/_10sdp"
                    android:visibility="gone" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/_2sdp"
                    android:text="State"
                    android:textColor="@color/text_color_personal"
                    android:textSize="@dimen/_11sdp" />

                <TextView
                    android:id="@+id/etNomineeCorresStateError"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_minus5sdp"
                    android:background="@null"
                    android:enabled="false"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:textColor="@color/upload_red"
                    android:textSize="@dimen/_10sdp"
                    android:visibility="gone" />

                <com.mosl.mobile.ekyc.common.SearchableSpinner
                    android:id="@+id/spNomineeCorresState"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_40sdp"
                    android:layout_marginBottom="@dimen/_2sdp" />

                <EditText
                    android:id="@+id/etNomineeCorresState"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_minus5sdp"
                    android:enabled="false"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:visibility="gone" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/_2sdp"
                    android:layout_marginTop="@dimen/_5sdp"
                    android:text="City/ Town/Village"
                    android:textColor="@color/text_color_personal"
                    android:textSize="@dimen/_11sdp" />

                <TextView
                    android:id="@+id/etNomineeCorresCityError"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_minus5sdp"
                    android:background="@null"
                    android:enabled="false"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:textColor="@color/upload_red"
                    android:textSize="@dimen/_10sdp"
                    android:visibility="gone" />

                <com.mosl.mobile.ekyc.common.SearchableSpinner
                    android:id="@+id/spNomineeCorresCity"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_40sdp"
                    android:layout_marginBottom="@dimen/_2sdp" />

                <EditText
                    android:id="@+id/etNomineeCorresCity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_minus5sdp"
                    android:enabled="false"
                    android:visibility="gone" />

              <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/inputLayoutNomineeCorresCityOther"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_6sdp">

                    <EditText
                        android:id="@+id/etNomineeCorresCityOther"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="City"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:visibility="gone" />
              </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/_2sdp"
                    android:text="Country"
                    android:textColor="@color/text_color_personal"
                    android:textSize="@dimen/_11sdp" />

                <TextView
                    android:id="@+id/etNomineeCorresCountryError"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_minus5sdp"
                    android:background="@null"
                    android:enabled="false"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:textColor="@color/upload_red"
                    android:textSize="@dimen/_10sdp"
                    android:visibility="gone" />

                <Spinner
                    android:id="@+id/spNomineeCorresCountry"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_40sdp"
                    android:layout_marginBottom="@dimen/_2sdp"
                    android:entries="@array/country" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                  <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/inputLayoutNomineeSTD"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_5sdp"
                        android:layout_weight="1">

                        <EditText
                            android:id="@+id/etNomineeSTDNo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="@dimen/_2sdp"
                            android:hint="STD"
                            android:inputType="number"
                            android:maxLength="5"
                            android:maxLines="1"
                            android:singleLine="true" />
                  </com.google.android.material.textfield.TextInputLayout>

                  <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/inputLayoutNomineeTelNo"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_5sdp"
                        android:layout_weight="3">

                        <EditText
                            android:id="@+id/etNomineeTelNo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="@dimen/_2sdp"
                            android:hint="Telephone (Res.)"
                            android:inputType="number"
                            android:maxLength="8"
                            android:maxLines="1"
                            android:singleLine="true" />
                  </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/etNomineeSTDTelError"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_minus5sdp"
                    android:background="@null"
                    android:enabled="false"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:textColor="@color/upload_red"
                    android:textSize="@dimen/_10sdp"
                    android:visibility="gone" />

              <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/inputLayoutNomineeEmail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_5sdp">

                    <EditText
                        android:id="@+id/etNomineeEmail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/_2sdp"
                        android:hint="Email ID (abc@gmail.com)"
                        android:inputType="textEmailAddress"
                        android:maxLines="1"
                        android:singleLine="true" />
              </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:id="@+id/etNomineeEmailError"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_minus5sdp"
                    android:background="@null"
                    android:enabled="false"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:textColor="@color/upload_red"
                    android:textSize="@dimen/_10sdp"
                    android:visibility="gone" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/_2sdp"
                    android:text="Nominees Relationship with Primary Applicant"
                    android:textColor="@color/text_color_personal"
                    android:textSize="@dimen/_11sdp" />

                <TextView
                    android:id="@+id/etNomineesRelationshipError"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_minus5sdp"
                    android:background="@null"
                    android:enabled="false"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:textColor="@color/upload_red"
                    android:textSize="@dimen/_10sdp"
                    android:visibility="gone" />

                <Spinner
                    android:id="@+id/spNomineesRelationship"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_40sdp"
                    android:layout_marginBottom="@dimen/_2sdp" />

              <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/inputLayoutNomineesRelationship"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <EditText
                        android:id="@+id/etNomineesRelationship"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/_2sdp"
                        android:layout_weight="1"
                        android:hint="Nominees Relationship with Primary Applicant"
                        android:maxLength="50"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:visibility="gone" />
              </com.google.android.material.textfield.TextInputLayout>

              <!--<com.google.android.material.textfield.TextInputLayout
                  android:id="@+id/inputLayoutNomineePrimaryApplicantsRelationship"
                  android:layout_width="match_parent"
                  android:layout_height="wrap_content">

                  <EditText
                      android:id="@+id/etNomineePrimaryApplicantsRelationship"
                      android:layout_width="match_parent"
                      android:layout_height="wrap_content"
                      android:layout_marginBottom="@dimen/_2sdp"
                      android:layout_weight="1"
                      android:hint="Primary Applicants Relationship with Nominees"
                      android:maxLines="1"
                      android:singleLine="true"
                      android:textColor="@color/text_color_personal" />
              </com.google.android.material.textfield.TextInputLayout>-->

            </LinearLayout>


            <LinearLayout
                android:id="@+id/llNomineeGuardian"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <include layout="@layout/layout_nominee_gardian_details" />
            </LinearLayout>

            <!--<RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_5sdp"
                android:background="@color/light_grey_menu"
                android:padding="@dimen/_5sdp"
                android:visibility="visible">

                <Button
                    android:id="@+id/btnSaveNominee"
                    android:layout_width="@dimen/_150sdp"
                    android:layout_height="@dimen/_35sdp"
                    android:layout_centerHorizontal="true"
                    android:background="@drawable/ic_submit_btn"
                    android:text="Save"
                    android:textColor="@color/white" />
            </RelativeLayout>-->
        </LinearLayout>
    </ScrollView>
</RelativeLayout>